# `pnpm summary` 的模型配置。
#
# 复制成 `.env` 后填入真实值；`.env` 与 `.env.*` 已被 .gitignore 挡掉，本文件是例外。
# 读取靠 node 原生的 --env-file-if-exists（package.json 的 summary 脚本已带），
# 不需要 dotenv。**没有任何脚本会打印 LLM_API_KEY。**
#
# 三家都吃这套 OpenAI 兼容格式，换 provider 只改 BASE_URL 和 MODEL 两行：
#   Moonshot  https://api.moonshot.cn/v1
#   DeepSeek  https://api.deepseek.com/v1
#   OpenAI    https://api.openai.com/v1

# 端点根（不含 /chat/completions，脚本自己拼）
LLM_BASE_URL=

# 密钥。缺任何一项时 `pnpm summary --write` 会报一行配置缺失并退出 1，
# dry-run 不需要它
LLM_API_KEY=

# 模型名。它有两个身份：请求用的模型，以及写进 $meta.model 的徽章署名。
# 两者必须是同一个值，否则 38 篇文章会署一个不是它们来源的名字
LLM_MODEL=

# 单次请求超时（毫秒），可选，默认 60000
LLM_TIMEOUT_MS=