{
  "name": "clarity",
  "type": "module",
  "version": "3.8.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "license": "(MIT OR CC-BY-NC-SA-4.0)",
  "homepage": "https://blog.sotkg.com",
