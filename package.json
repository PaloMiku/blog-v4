  "engines": {
    "node": "^22.19 || ^24.11 || >=26",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "typecheck": "astro sync && tsc -p tsconfig.check.json",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "accept": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/acceptance.ps1",
    "accept:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/acceptance.ps1 -Profile full",
    "freeze-baseline": "node scripts/freeze-baseline.mjs",
    "interaction-check": "node scripts/interaction-check.mjs",
    "new": "node scripts/new-blog.ts"
  },
  "dependencies": {
