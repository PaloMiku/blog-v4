---
/**
 * Blog 布局 —— 三栏外壳。
 *
 * 对应 `app/layouts/default.vue`。结构与 class/id 名必须逐字一致，
 * 因为 CSS 依赖 `:has(> .blog-aside-track > :global(#blog-aside):not(.is-empty))`
 * 决定是否收成两栏。改名会静默破坏响应式布局。
 */
import BlogAside from '../components/blog/BlogAside.astro'
import BlogFooter from '../components/blog/BlogFooter.astro'
import BlogPanel from '../components/blog/BlogPanel.astro'
import BlogSidebar from '../components/blog/BlogSidebar.astro'
import SkipToContent from '../components/blog/SkipToContent.astro'
import Base from './Base.astro'
import ModalHost from '../components/ModalHost.astro'
import '../styles/index.css'

interface Props {
	title: string
	/** 是否有具名 aside 插槽（对应 Nuxt 的 provideLayoutSlots().aside） */
	hasAside?: boolean
	/**
	 * 以下三项只往 Base.astro 透传，让各页自己声明 SEO 数据。
	 *
	 * 为什么需要：源项目的 unhead `useSeoMeta` 是**逐页声明**的
	 * （`app/pages/index.vue:5-8`、`link.vue:12-16` 等），
	 * 不在 `app/app.vue` 里。若不给页面传值的通道，
	 * `Base.astro` 就只能按 pathname 硬编码一张映射表——
	 * 那是把页面自己的数据搬到布局里，与源项目结构相反。
	 */
	description?: string
	image?: string
	ogType?: 'website' | 'article' | 'profile'
	noindex?: boolean
	/** 透传给 Base.astro：省掉 description / og:image / canonical（见 Base 的注释） */
	minimalSeo?: boolean
	/** 透传给 Base.astro 的内容页结构化数据节点 */
	jsonLd?: Record<string, unknown>[]
}

const {
	title,
	hasAside = false,
	description,
	image,
	ogType,
	noindex,
	minimalSeo,
	jsonLd,
} = Astro.props
---

<Base title={title} description={description} image={image} ogType={ogType} noindex={noindex} minimalSeo={minimalSeo} jsonLd={jsonLd}>
	{/*
	 * 键盘用户的「跳到正文」入口。对应 `app/layouts/default.vue` 里
	 * `<BlogSkipToContent />` 的位置（BlogSidebar 之前）。
	 * 组件早就写好了、也与基线逐字一致，只是先前没有任何布局引用它——
	 * 静态 HTML 与浏览器实测里都找不到 `a.skip-link`，
	 * 于是一条无障碍通路在迁移中静默丢失，且因为「没报错」一直没人发现。
	 */}
	<SkipToContent />

	<BlogSidebar />

	<main id="main-content">
		<slot />
	</main>

	{/* 与正文同高的容器限制侧栏 sticky 边界，让页脚进入视口时将侧栏向上顶走。 */}
	<div class="blog-aside-track">
		{/*
		 * `hasAside` 必须显式传下去，否则 BlogAside 会退回
		 * `Astro.slots.has('default')` 推断——而下面这个 `<slot name="aside" />`
		 * **无论页面有没有提供 aside 都会被塞进默认 slot**，推断恒为 true，
		 * 于是 `<aside>` 永远拿不到 `is-empty`，
		 * `#blog-root:not(:has(> … #blog-aside:not(.is-empty)))` 永不成立，
		 * 无侧栏的页面（如 /link）也会按三栏排版，正文被压窄 296px。
		 */
		}
		<BlogAside hasAside={hasAside || Astro.slots.has('aside')}>
			<slot name="aside" />
		</BlogAside>
	</div>

	<BlogFooter />
	<BlogPanel hasAside={hasAside} />

	{/* 模态栈宿主：搜索、灯箱等弹窗的唯一挂载点（@bikariya/modals 的替代） */}
	<div id="modal-root">
		<ModalHost />
	</div>
</Base>

<script>
	/*
	 * 侧栏 / 侧边栏可见性的**唯一**写入口。
	 *
	 * ## 为什么住在布局层而不是各组件里
	 * Task 6 之前有两套：`BlogSidebar.astro` 订阅 `layout-state` 切 `.show`，
	 * `BlogAside.astro` 另有一份 `applyLayout()` 管 `.show` + `aria-hidden`，
	 * 还带一个自己的 matchMedia 监听。规格要求「统一走同一可见性函数，
	 * resize 不能把折叠栏重新暴露」「Shell 与 Aside 不能写相反状态」——
	 * 两套实现的差别正好是这些缺陷的来源。
	 *
	 * ## 判据只有三份输入，全部可读、全部同源
	 * 1. `layout-state` 的当前状态（抽屉开没开）；
	 * 2. 视口（`matchMedia`），由**本函数自己**持有监听。
	 *
	 * CSS 侧的收起规则读的是视口，JS 侧写 `aria-hidden` / `inert` 读的也是视口，
	 * 两侧因此不可能分叉——这是「不创建两个真相源」的具体落点。
	 *
	 * ## 为什么 `aria-hidden` 与 `inert` 要一起写
	 * `aria-hidden` 挡读屏，`inert` 挡 Tab 顺序与点击。只写前者时，
	 * 收起状态下栏内的项仍能被键盘聚焦进去，于是「收起了」的侧栏变成一条
	 * 看不见的焦点通路；只写 `inert` 则读屏软件仍会念出整栏目录。
	 */
	import { bindLayoutGlobals, drawerMediaQuery, getLayoutState, subscribeLayout } from '../lib/layout-state'

	/**
	 * 一侧栏的静态配置。
	 *
	 * 断点来自 `layout-state.ts` 的 `LAYOUT_BREAKPOINTS`（唯一定义处），
	 * **不再在这里手写 `(max-width: …)`**：此前 CSS 与本文件各写一份、只靠注释同步，
	 * 漂移的症状是「抽屉已滑出画布却仍可 Tab 进去」。
	 */
	const COLUMNS = [
		{ id: 'blog-sidebar', key: 'sidebar', drawer: drawerMediaQuery('sidebar') },
		{ id: 'blog-aside', key: 'aside', drawer: drawerMediaQuery('aside') },
	]

	/**
	 * 这一侧此刻是否应当收起。**唯一**的判据，`.show` 与 `aria-hidden` / `inert` 都由它推出。
	 *
	 * 收起条件只有一条：视口窄于该列的 `drawer` 断点，且这侧抽屉没开。
	 *
	 * 空侧栏（`is-empty`）不在这里判：它在 `applyColumnVisibility()` 开头就被整块跳过
	 * （那是构建期写在模板上的事实），留一个永远走不到这里的分支只会误导下一个人。
	 */
	function isCollapsed(key, media) {
		if (getLayoutState() === key)
			return false
		return media.matches
	}

	/**
	 * 把判定结果同时写进 `.show` 与无障碍属性。
	 *
	 * `.show` 原来由两个组件各自订阅 `layout-state` 写；收拢到这里之后
	 * 「谁开着抽屉」这件事全站只有这一处判断，`BlogAside` 不再需要自己的
	 * `applyLayout()` 与媒体查询监听（resize 不可能只更新一边）。
	 *
	 * 空侧栏整个跳过：`hidden` + `inert` + `is-empty` 是 `BlogAside.astro`
	 * **构建期**写死在模板上的事实（「本页没有 aside 内容」），不是运行期状态。
	 * 脚本去动它要么摘掉 `inert`（空壳侧栏重新进入焦点顺序），
	 * 要么补一个 `aria-hidden`（对一个 `display: none` 的元素纯属噪音）。
	 */
	function applyColumnVisibility(column, key, media) {
		if (column.classList.contains('is-empty'))
			return

		const collapsed = isCollapsed(key, media)

		column.classList.toggle('show', getLayoutState() === key)
		if (collapsed) {
			column.setAttribute('aria-hidden', 'true')
			column.setAttribute('inert', '')
		}
		else {
			column.removeAttribute('aria-hidden')
			column.removeAttribute('inert')
		}
	}

	/**
	 * 初始化。幂等：`astro:page-load` 与 `DOMContentLoaded` 可能都先到，
	 * 而本仓库尚未启用 ClientRouter（换页是整页跳转），所以重复订阅不会发生；
	 * 一旦启用，下面这个 `dataset` 标记就是防线。
	 */
	function initColumns() {
		for (const { id, key, drawer } of COLUMNS) {
			const column = document.getElementById(id)
			if (!column || column.dataset.columnReady)
				continue
			column.dataset.columnReady = '1'

			// 媒体查询只在这里建一次，三个回调共用它
			const media = window.matchMedia(drawer)
			const apply = () => applyColumnVisibility(column, key, media)

			subscribeLayout(apply)
			media.addEventListener('change', apply)
			apply()
		}
	}

	if (document.readyState === 'loading')
		document.addEventListener('DOMContentLoaded', initColumns)
	else
		initColumns()
	document.addEventListener('astro:page-load', initColumns)

	bindLayoutGlobals()
</script>

<style>
	:global(#blog-root) {
		--aside-width: 280px;
		--sidebar-width: var(--aside-width);

		display: grid;
		grid-template-columns: var(--sidebar-width) minmax(0, 1fr) var(--aside-width);
		align-items: start;
		column-gap: 1rem;
		width: 100%;
		min-width: 0;

		/*
		 * 外壳总宽 = 侧边栏 + 正文列 + 右侧栏 + 两个列隙。
		 *
		 * 原本写死的是 `calc(var(--aside-width) + 1rem + 1080px)`，那个 "1080px"
		 * 是**外壳总预算**而不是正文列宽：1376 − 280 − 280 − 32 = **784px**，
		 * 也就是正文列的真实宽度（1440px 视口下 CDP 实测）。
		 *
		 * 改成跟着 `--article-width` 走，是因为访客要在设置面板里调正文宽度——
		 * 只在 `#main-content` 上加 `max-width` 的话**只能变窄不能变宽**：
		 * 外壳本身卡在 1376，多出来的宽度无处可去。
		 * 缺省 `784px`（声明在 `article.css` 的 `:root`）代回上式
		 * `280 + 784 + 280 + 32 = 1376`，与原值逐位相同，现状零变化。
		 */
		max-width: calc(var(--sidebar-width) + var(--article-width) + var(--aside-width) + 2rem);
		margin-inline: auto;

		&:not(:has(> .blog-aside-track > :global(#blog-aside):not(.is-empty))) {
			grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
		}

		@media (max-width: 1080px) {
			--sidebar-width: clamp(240px, 25vw, var(--aside-width));

			&, &:not(:has(> .blog-aside-track > :global(#blog-aside):not(.is-empty))) {
				grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
			}
		}

		@media (max-width: 768px) {
			&, &:not(:has(> .blog-aside-track > :global(#blog-aside):not(.is-empty))) {
				grid-template-columns: minmax(0, 1fr);
			}
		}
	}

	:global(#blog-sidebar),
	:global(#blog-aside) {
		position: sticky;
		top: 0;
		height: 100vh;
		height: 100dvh;
		min-width: 0;
		scrollbar-width: thin;
	}

	:global(#blog-sidebar) {
		grid-area: 1 / 1;
	}

	:global(#main-content) {
		grid-area: 1 / 2;
		/* 保留语义 main 和可见溢出，不影响正文内的 sticky 元素。 */
		min-width: 0;

		/*
		 * 内容区阅读宽度（访客可在设置面板里调，见 `src/lib/user-settings.ts`）。
		 *
		 * **绝不改 `--sidebar-width` / `--aside-width`**：那两者一动，侧边栏内部
		 * 那些已经逐像素对齐过的排版就全乱了（见 `BlogSidebar.astro` 里关于
		 * 每项 8.64px / 1.72px 对齐的注释）。给中间这列加 max-width 并居中，
		 * 是唯一影响面局限在正文内的做法。
		 *
		 * 变宽靠的是上一条 `#blog-root` 的 `max-width` 跟着一起放宽；
		 * 这一条只负责「变窄时居中留白」。
		 *
		 * `min-width: 769px` 而非 `not (max-width: 768px)`：用户明确要求
		 * 窄屏不生效——单列布局下正文本来就该撑满。断点值与
		 * `LAYOUT_BREAKPOINTS.sidebar` 同源，`scripts/check-breakpoints.mjs`
		 * 盯着这两处不要漂移。
		 */
		@media (min-width: 769px) {
			max-width: var(--article-width);
			margin-inline: auto;
		}

		@media (max-width: 768px) {
			grid-column: 1;
		}
	}

	.blog-aside-track {
		display: contents;

		@media not (max-width: 1080px) {
			&:has(> :global(#blog-aside):not(.is-empty)) {
				display: block;
				grid-area: 1 / 3;
				align-self: stretch;
				min-width: 0;
			}
		}
	}

	/*
	 * 整个选择器必须包进一个 :global()。
	 *
	 * 写成 `:global(#blog-root) > .blog-footer` 时，Astro 只把 `#blog-root`
	 * 变成全局，**组合符后面的 `.blog-footer` 仍然被 scoped**，产物里出来是：
	 *   #blog-root > .blog-footer[data-astro-cid-<Blog.astro 的 cid>]
	 * 而 `.blog-footer` 是 BlogFooter.astro 渲染的，带的是它自己的 cid，
	 * 于是这条规则**永远不匹配**——页脚因此不是 grid item，宽度从
	 * 1048px 塌成 248px（shrink-to-fit），三栏被挤成纵向。
	 * 实测代价：每个有页脚的页面都多出 349~582px 高度。
	 *
	 * 同理，`.blog-aside-track` 之所以能裸写，是因为它确实由本组件的
	 * 模板渲染；凡是不在本组件模板里的元素，选择器就得整体 global。
	 */
	:global(#blog-root > .blog-footer) {
		grid-area: 2 / 2 / auto / -1;
		min-width: 0;

		@media (max-width: 768px) {
			grid-column: 1 / -1;
		}
	}
</style>
