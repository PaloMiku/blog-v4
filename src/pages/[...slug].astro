---
import { getCollection, render } from 'astro:content'
import Blog from '../layouts/Blog.astro'
import Collection from '../components/post/Collection.astro'
import Comment from '../components/post/Comment.astro'
import Excerpt from '../components/post/Excerpt.astro'
import PostFooter from '../components/post/PostFooter.astro'
import PostHeader from '../components/post/PostHeader.astro'
import PostRelated from '../components/post/PostRelated.astro'
import PostSurround from '../components/post/PostSurround.astro'
import Toc from '../components/widget/Toc.astro'
import { contentComponents } from '../lib/content-components'
import blogConfig from '../config/blog'
import { compat } from '../config/compat'
import type { BigPicturePage } from '../lib/big-picture-state'

// 对应 Nuxt 侧的 app/pages/[...slug].vue + content:file:afterParse 的 path 改写。
// 条目 id 已由 content.config.ts 的 generateId 处理（permalink 优先，其次去 /posts 前缀）。
//
// RESERVED：由 `src/pages/` 下的专用静态路由独占的内容条目 id。
// `link.mdx` 的正文由 `link.astro` 合并渲染（友链列表 + 申请要求同一页），
// 若兜底路由继续为它声明 `/link`，两条路由指向同一输出文件，
// Astro 每次构建都会打一条 route conflict 告警（EC-002 前靠白名单放行）。
// 注意：getStaticPaths 会被提升到组件作用域之外，集合必须写在这里函数体内。
// 新增专用路由且其路径恰好命中内容条目 id 时，在这里加一项。
export async function getStaticPaths() {
	const reserved = new Set(['link'])
	const entries = await getCollection('content')
	return entries
		.filter(entry => !reserved.has(entry.id))
		.map(entry => ({
			params: { slug: entry.id },
			props: { entry },
		}))
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)

// 「合集」区块的显隐由 compat.hideCollectionBlock 统一控制（2026-10-13 起暂时关闭，
// 组件与登记项都还在仓库里）。开关语义与恢复条件见 src/config/compat.ts。

// 对应 Nuxt 的 useWidgets()：frontmatter 的 aside 决定侧栏挂哪些组件。
// `meta-aside-*` 由 rehype-meta-slots 提取成 metaSlots，消费侧需去掉 `meta-` 前缀。
const asideNames = (entry.data.aside as string[] | undefined) ?? ['toc']
const hasAside = asideNames.length > 0
const tocHeadings = asideNames.includes('toc') ? headings : []

/**
 * 本页的大屏页面类型（spec §模式与布局状态）。
 *
 * ## 为什么按**内容身份**判，而不是按 URL 前缀判
 * 这个兜底路由同时承载文章、游戏档案、关于页等多种条目，它们的 URL 由
 * `generateId` 决定：frontmatter 的 `permalink` **优先于**磁盘路径，
 * 且 `hidePostPrefix` 会把 `/posts/foo` 显示成 `/foo`（见 `lib/shared/content-id.ts`）。
 * 也就是说 `/[…slug]` 渲染出来的路径与「它是什么」并非一一对应：
 * 一篇 permalink 写成 `/games/xxx` 的文章，按 URL 前缀会被判成游戏页；
 * 反过来一条 `games/` 下的条目把 permalink 指到别处，按前缀就漏判。
 * 按 URL 前缀判等于把「路由长什么样」当成语义，一旦有人改 permalink 就静默失配。
 * 所以这里只读**构建期就已确定的身份**：schema 字段 `isPost` 与条目 id 的栏目归属。
 *
 * ## 判据顺序
 * 1. `entry.data.isPost` —— 由 `withArticleMeta` loader 按真实 `filePath` 的
 *    `posts/` 段算出（id 已剥前缀，**不能**用 id 反推，见 `loaders/with-article-meta.ts:124`）；
 * 2. 游戏栏目：内容 id 为 `games` 或以 `games/` 开头（`games/index.mdx` 经 `generateId`
 *    塌缩成 `games`，所以两种都要覆盖）；
 * 3. 关于页：id 恰为 `about`；
 * 4. 其余一律 `'off'`——`drive`、`link`（正文由专用路由合并渲染）、`previews/*`
 *    都没有对应页型，缺省停用增强是安全缺省（会话意图仍保留，回核心页面自动恢复）。
 *
 * 注：`'links'` 与 `'archive'` / `'home'` 不在此处——它们由各自专用路由声明，
 * 这里出现的任何条目都不该被判成那三种页型。
 */
const bigPicturePage: BigPicturePage
	= entry.data.isPost
		? 'reading'
		: entry.id === 'games' || entry.id.startsWith('games/')
			? 'games'
			: entry.id === 'about'
				? 'reading'
				: 'off'

/**
 * 内容页的 BlogPosting 结构化数据。
 *
 * 基线的 unhead `schemaOrgGraph` 只有 WebSite + WebPage 两个节点
 * （`app/app.vue` 里并没有 useSeoMeta，meta 是逐页声明的），
 * 不含 headline / datePublished / author / image——这里补齐，属净增项。
 * 用 `jsonLd` prop 传下去，Base.astro 不再反查内容集合。
 */
function toIsoDate(value?: string) {
	if (!value)
		return undefined
	const [date, time = '00:00:00'] = value.split(' ')
	// frontmatter 日期按 blog.config.ts 的 timeZone（Asia/Shanghai，1991 年后无夏令时）转 +08:00
	return `${date}T${time}+08:00`
}

const siteUrl = blogConfig.url
const canonicalUrl = new URL(`/${entry.id}`, siteUrl).toString()
const imageUrl = entry.data.image ? new URL(entry.data.image, siteUrl).toString() : undefined

/**
 * meta description：`seo` 优先，缺省时**不要**让 22 个页面共用同一句站点简介。
 *
 * 2026-10-03 实测：63 个 mdx 里有 25 个没有摘要（全是 `content/games/`
 * 下的 galgame 条目），它们全部回落到 `blogConfig.description`，于是 25 个页面的
 * meta description 逐字相同。重复的 description 对这些页面没有任何区分度——
 * 它们能被抓到的关键词全在标题里，描述栏却写着一句跟本页无关的站点简介。
 *
 * 这里按「标题 + 站点名」合成一句：至少**逐页唯一**、含标题这个主检索词。
 * ⚠️ 这是**占位**，质量上限有限。games/ 下的条目没有写进 summaries.json，
 * 要给它们正经描述得先补 JSON 条目。
 */
const seoDescription = entry.data.seo
	?? `「${entry.data.title ?? entry.id}」——${blogConfig.title}`

const jsonLd: Record<string, unknown>[] = [
	{
		'@id': `${canonicalUrl}#blogposting`,
		'@type': 'BlogPosting',
		'headline': entry.data.title,
		...(seoDescription ? { description: entry.data.summary ?? seoDescription } : {}),
		...(imageUrl ? { image: imageUrl } : {}),
		...(toIsoDate(entry.data.date) ? { datePublished: toIsoDate(entry.data.date) } : {}),
		...(toIsoDate(entry.data.updated ?? entry.data.date) ? { dateModified: toIsoDate(entry.data.updated ?? entry.data.date) } : {}),
		'author': {
			'@type': 'Person',
			'name': blogConfig.author.name,
			'url': blogConfig.author.homepage,
		},
		'url': canonicalUrl,
		'mainEntityOfPage': { '@id': `${canonicalUrl}#webpage` },
		'isPartOf': { '@id': `${siteUrl}#website` },
	},
]
---

<Blog
		title={entry.data.title ?? entry.id}
		hasAside={hasAside}
		bigPicturePage={bigPicturePage}
		description={seoDescription}
		image={entry.data.image}
		ogType="article"
		hasMath={entry.data.hasMath}
	jsonLd={jsonLd}
	>
	{/*
	 * 这里**不能再套一层 `<main>`**：布局层 `Blog.astro` 已经提供了
	 * `<main id="main-content">`，一个文档只能有一个 main，嵌套是无效 HTML。
	 *
	 * 而且基线的层级是 `#main-content > [post-header, excerpt, article,
	 * post-footer, surround-post, z-comment]` —— 全是兄弟节点。
	 * 此前把 post-header 与 excerpt 放进了 `<article>` 内部，
	 * 于是它们开始继承 `styles/article.css` 的正文样式
	 * （那份文件的注释明说 `.article` 是正文样式的唯一入口），
	 * 实测这正是「侧栏目录矮 126px、正文高 126px」两边抵消的来源之一。
	 */}
	{entry.data.title && (
		<PostHeader
			title={entry.data.title}
			subtitle={entry.data.subtitle}
			date={entry.data.date}
			updated={entry.data.updated}
			image={entry.data.image}
			categories={entry.data.categories}
			tags={entry.data.tags}
			type={entry.data.type}
			readingTime={entry.data.readingTime}
		/>
	)}

	{/* 无摘要条目（JSON 里没键）整块不输出 */}
	{entry.data.summary && <Excerpt excerpt={entry.data.summary} model={entry.data.summaryModel} />}

	{/*
	 * 正文阅读入口。spec §按键语义 要求「正文阅读入口使用临时 `tabindex="-1"`，
	 * 只供程序聚焦」。这里渲染成一个**真链接**（`href="#main-content"`），理由如下。
	 *
	 * ⚠️ **`tabindex="-1"` 本身就会让它成为手柄目标，光去掉 `data-gamepad-focus` 不够。**
	 * `gamepad-focus.ts:81-90` 的 `FOCUS_SELECTOR` 里含 `[tabindex]`，而
	 * `isSelectable()`（:342-353）只额外要求「有非零盒子 + 未被 hidden/inert/aria-hidden」。
	 * 所以只要这个 span 带 `tabindex="-1"` 且有自己的盒子，它就是**候选目标**；
	 * 在没有 `data-gamepad-initial-focus` 的页型上（`/games`、`/about`），
	 * `chooseRegionTarget()` 会按 DOM 顺序挑到它 ⇒ 手柄一进模式就停在一个
	 * **按 A 什么都不做**的死停靠点上。实测正是这一条让 `/games` 的 A 键失效。
	 *
	 * 修法不是把它藏起来，而是**让它真的可点**：`#main-content` 由 `Blog.astro`
	 * 稳定提供（每页都有），所以渲染成 `<a href="#main-content">`——
	 * 按 A 是真实的站内跳转（跳到正文开头），与「阅读入口」的语义一致，
	 * 也不再是一个假停靠点。
	 *
	 * ⚠️ 它还必须**自带一个非零盒子**：见上，`rect.width > 0 && rect.height > 0`
	 * 是入选前提；空 inline 元素的矩形是 0×0，会静默出局。故样式见
	 * `big-picture.css` 的 `.reading-anchor`（`display:block` + 1px 高）。
	 *
	 * `data-gamepad-initial-focus` 带页型条件：本路由同时服务文章、游戏页与关于页，
	 * 只有真正的阅读页才把「正文入口」当首选；其余页型回落到它们自己的首选项。
	 */}
	<a
		class="reading-anchor"
		href="#main-content"
		data-gamepad-initial-focus={bigPicturePage === 'reading' ? '' : undefined}
		data-list-key="reading:anchor"
		tabindex="-1"
		aria-label="跳到正文"
	></a>

	{/*
	 * 合集块：位于正文**之前**（移植自 plumz.me 的 playlist 位置——文章 meta 之后、
	 * 正文之前），理由与那边相同：读者进正文前先知道「这是连载第几篇、前面还有什么」。
	 *
	 * 放在 `reading-anchor` **之后**是刻意的：那个锚点是正文阅读入口，
	 * 手柄在阅读页靠 `data-gamepad-initial-focus` 命中它，而其余页型回落到
	 * 「区域内 DOM 顺序第一项」——把合集插在它前面会顶掉那个兜底首选。
	 */}
	{!compat.hideCollectionBlock && <Collection currentId={entry.id} collectionKey={entry.data.collection} />}

	{/*
	 * `article` 只包正文本身，class 与基线一致。
	 *
	 * `data-gamepad-region="main"` 是**手柄大屏模式**的落点，不是样式钩子：
	 * `gamepad-focus.ts` 的判据是「元素必须落在某个已注册区域内」，落在任何区域
	 * 之外的元素**根本不是候选**（该文件 :13-16）。少了这个属性，整页正文在手柄下
	 * 不可达——而静态扫描只看属性是否存在，看不见「有属性但没标记区域」这层。
	 * 本页（阅读/游戏/关于）由 `#main-content` 承载正文，故区域标在这里；
	 * 不标在 `Blog.astro` 的 `#main-content` 上，是因为那个布局文件被所有页面共用，
	 * 而 region 是**页面级**声明（首页与归档各自标在 `.post-list` / `.archive`）。
	 */}
	<article class={`article md-${entry.data.type || 'tech'}`} data-gamepad-region="main">
		<Content components={contentComponents} />
	</article>

	{!entry.data.hideInfo
		&& <PostFooter
			title={entry.data.title}
			path={`/${entry.id}`}
			date={entry.data.date}
			updated={entry.data.updated}
			references={entry.data.references}
		/>}
	<PostSurround currentId={entry.id} />
	{/*
	 * 相关阅读：排在上下篇之后、评论之前。它是「读完这篇还能读什么」，
	 * 而上下篇解决的是「按时间接着走」——两者是不同的意图，后者先答完。
	 * 组件内部对非文章条目（游戏页、关于页）算出空候选时整块不输出，
	 * 因此这里不需要条件渲染。
	 */}
	<PostRelated currentId={entry.id} />
	<Comment />

	<Fragment slot="aside">
		{/* 只要 aside 里有 toc 就渲染。Nuxt 侧 Toc 是 widget 系统里的一环，
		    始终挂载、无标题时由组件自己显示 `.no-toc` 占位；
		    此前按 `tocHeadings.length > 0` 跳过，导致无目录的页面
		    整个目录组件消失，而 `.no-toc` 的样式成了死 CSS。 */}
		{asideNames.includes('toc') && <Toc headings={tocHeadings} />}
	</Fragment>
</Blog>

<script>
	// prose 增强层：代码块复制/换行/折叠、表格换行切换、段落引用、标题锚点。
	// 标记由 src/plugins/prose.ts 在构建期生成，行为在这里补。
	import { initProseEnhance } from '../lib/prose-enhance'

	initProseEnhance()
</script>
