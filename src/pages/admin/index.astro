---
/**
 * 后台概览：站点数据一屏总览。
 *
 * ## 口径：这里数的是「文章」，不是「全部内容」
 * 站点内容集合里除文章外还有 games / about / drive / previews 等**非文章页**
 * （`isPost === false`）。`getStats()` 的 `includePaths` 缺省为空 = 统计**全部**条目，
 * 所以直接拿它的 `total.posts`（63）当「文章数」会和文章列表页（38 篇）对不上——
 * 同一个后台里两个数字打架，是很难排查的错。
 * 故此处一律按 `isPost` 过滤后现算：文章数、字数、标签、草稿数，
 * 与 `/admin/posts/` 列表**同源同口径**。需要全站口径时看 `/api/stats`。
 *
 * 「最近更新」按 `updated ?? date` 倒序取前 N 条——后台关心的是"最近动过哪几篇"。
 */
import AdminLayout from '../../layouts/AdminLayout.astro'
import Icon from '../../components/Icon.astro'
import { getAllContent } from '../../lib/content'
import { formatNumber } from '../../lib/shared'

const posts = (await getAllContent()).filter(e => e.data.isPost)

const postCount = posts.length
const totalWords = posts.reduce((sum, e) => sum + (e.data.readingTime?.words ?? 0), 0)
const tagCount = new Set(posts.flatMap(e => e.data.tags ?? [])).size
const drafts = posts.filter(e => e.data.draft).length

const recent = [...posts]
	.sort((a, b) => (b.data.updated ?? b.data.date ?? '').localeCompare(a.data.updated ?? a.data.date ?? ''))
	.slice(0, 6)

// 分类分布（取每个条目的一级分类，与归档页 categorizeArticles 口径一致）
const byCategory = new Map<string, number>()
for (const post of posts) {
	const cat = post.data.categories?.[0] ?? '未分类'
	byCategory.set(cat, (byCategory.get(cat) ?? 0) + 1)
}
const categories = [...byCategory.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8)

---

<AdminLayout title="概览" active="dashboard">
	<section class="stat-grid" aria-label="站点统计">
		<div class="stat-card">
			<span class="stat-label"><Icon name="tabler:file-text" />文章</span>
			<strong class="stat-value">{formatNumber(postCount)}</strong>
		</div>
		<div class="stat-card">
			<span class="stat-label"><Icon name="tabler:bold" />总字数</span>
			<strong class="stat-value">{formatNumber(totalWords)}</strong>
		</div>
		<div class="stat-card">
			<span class="stat-label"><Icon name="tabler:tag" />标签</span>
			<strong class="stat-value">{formatNumber(tagCount)}</strong>
		</div>
		<div class="stat-card">
			<span class="stat-label"><Icon name="tabler:file-off" />草稿</span>
			<strong class="stat-value">{formatNumber(drafts)}</strong>
		</div>
	</section>

	<div class="dash-columns">
		<section class="panel">
			<header class="panel-head">
				<h2>最近更新</h2>
				<a class="panel-more" href="/admin/posts/">全部文章<Icon name="tabler:chevron-right" /></a>
			</header>
			<ul class="recent-list">
				{recent.length === 0 && <li class="empty">还没有文章</li>}
				{recent.map(post => (
					<li>
						<a class="recent-link" href={`/admin/posts/editor?id=${encodeURIComponent(post.id)}`}>
							<span class="recent-title">{post.data.title ?? post.id}</span>
							<span class="recent-date">{post.data.updated ?? post.data.date ?? '—'}</span>
						</a>
					</li>
				))}
			</ul>
		</section>

		<section class="panel">
			<header class="panel-head">
				<h2>分类分布</h2>
			</header>
			<ul class="category-list">
				{categories.length === 0 && <li class="empty">暂无分类</li>}
				{categories.map(([name, count]) => (
					<li class="category-row">
						<span class="category-name">{name}</span>
						<span class="category-bar">
							<i style={{ width: `${Math.round((count / Math.max(1, posts.length)) * 100)}%` }} />
						</span>
						<span class="category-count">{count}</span>
					</li>
				))}
			</ul>
		</section>
	</div>

	<section class="quick-actions">
		<a class="quick-card" href="/admin/posts/editor">
			<Icon name="tabler:pencil" />
			<span><strong>写新文章</strong><small>用 MDX 写，导出后提交进 src/content</small></span>
		</a>
		<a class="quick-card" href="/admin/posts/">
			<Icon name="tabler:layout-list" />
			<span><strong>管理文章</strong><small>浏览、筛选、编辑现有文章</small></span>
		</a>
	</section>
</AdminLayout>

<style>
.stat-grid {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
	gap: 0.8rem;
	margin-bottom: 1.4rem;
}

.stat-card {
	display: flex;
	flex-direction: column;
	gap: 0.4rem;
	padding: 1rem;
	border: 1px solid var(--c-border);
	border-radius: 0.7rem;
	background: var(--c-bg);

	.stat-label {
		display: inline-flex;
		gap: 0.4rem;
		align-items: center;
		color: var(--c-text-2);
		font-size: 0.82rem;
	}

	.stat-value {
		font-size: 1.5rem;
		font-variant-numeric: tabular-nums;
	}
}

.dash-columns {
	display: grid;
	grid-template-columns: 1.4fr 1fr;
	gap: 1rem;
	align-items: start;

	@media (width <= 56rem) {
		grid-template-columns: 1fr;
	}
}

.panel {
	border: 1px solid var(--c-border);
	border-radius: 0.7rem;
	background: var(--c-bg);
	overflow: hidden;
}

.panel-head {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 0.8rem 1rem;
	border-bottom: 1px solid var(--c-border);

	h2 {
		margin: 0;
		font-size: 0.95rem;
	}
}

.panel-more {
	display: inline-flex;
	gap: 0.2rem;
	align-items: center;
	color: var(--c-text-2);
	text-decoration: none;
	font-size: 0.82rem;

	&:hover {
		color: var(--c-primary);
	}
}

.recent-list {
	list-style: none;
	margin: 0;
	padding: 0.3rem;
}

.recent-link {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 1rem;
	padding: 0.55rem 0.7rem;
	border-radius: 0.5rem;
	color: inherit;
	text-decoration: none;

	&:hover {
		background: var(--c-bg-2);
	}

	.recent-title {
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
	}

	.recent-date {
		flex-shrink: 0;
		color: var(--c-text-3);
		font-size: 0.78rem;
		font-variant-numeric: tabular-nums;
	}
}

.category-list {
	list-style: none;
	margin: 0;
	padding: 0.6rem 1rem 0.9rem;
	display: flex;
	flex-direction: column;
	gap: 0.5rem;
}

.category-row {
	display: grid;
	grid-template-columns: 5.5rem 1fr 2rem;
	gap: 0.6rem;
	align-items: center;
	font-size: 0.85rem;

	.category-name {
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		color: var(--c-text-1);
	}

	.category-bar {
		height: 0.5rem;
		border-radius: 0.25rem;
		background: var(--c-bg-2);
		overflow: hidden;

		i {
			display: block;
			height: 100%;
			border-radius: inherit;
			background: var(--c-primary);
			min-width: 0.4rem;
		}
	}

	.category-count {
		text-align: end;
		color: var(--c-text-3);
		font-variant-numeric: tabular-nums;
	}
}

.quick-actions {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
	gap: 0.8rem;
	margin-top: 1.2rem;
}

.quick-card {
	display: flex;
	gap: 0.7rem;
	align-items: center;
	padding: 1rem;
	border: 1px solid var(--c-border);
	border-radius: 0.7rem;
	background: var(--c-bg);
	color: inherit;
	text-decoration: none;
	font-size: 1.1rem;

	&:hover {
		border-color: var(--c-primary);
	}

	span {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	small {
		color: var(--c-text-2);
		font-size: 0.78rem;
	}
}

.empty {
	padding: 1rem;
	color: var(--c-text-3);
	font-size: 0.85rem;
}
</style>