---
/**
 * 后台登录页。
 *
 * ## 这是什么、不是什么（请勿误读）
 * 本站是纯静态 SSG（无 server adapter），**没有服务端**，因此这一页
 * **不会校验任何密码、也不构成安全边界**。它只是把「是否进入过管理台」
 * 记在 sessionStorage 里，并在未进入时把 `/admin/**` 弹回这里。
 * 任何人都能绕过（直接改 localStorage / 删掉跳转脚本）。
 *
 * 真正的访问控制必须做在**部署层**（EdgeOne 访问规则 / 反向代理 Basic Auth /
 * Cloudflare Access），在服务器上拦截 `/admin/*`，让静态产物根本到不了浏览器。
 * 部署层的规则才是真正的门；本页只是交互上的一次询问。
 *
 * 因此这里没有密码框——设置一个"永远猜不中"的假密码只会给人安全错觉。
 * 只填一个昵称/邮箱即可进入，把决定权交给部署层。
 */
import Base from '../../layouts/Base.astro'
import Icon from '../../components/Icon.astro'
import { ADMIN_SESSION_KEY } from '../../lib/admin'
import blogConfig from '../../config/blog'

// 本页在 /admin/** 下，`lib/noindex-paths.ts` 已把该前缀纳入判定，
// Base 会据此输出 noindex；这里仍显式传一份，避免依赖隐式推断。
const noindex = true
---

<Base title="登录" noindex={noindex}>
	<div class="login-shell">
		<form class="login-card" data-login-form>
			<span class="login-icon"><Icon name="tabler:lock" /></span>
			<h1 class="login-title">{blogConfig.title} · 管理后台</h1>
			<p class="login-sub">输入昵称以进入本地编辑台</p>

			<label class="field">
				<span class="field-label">昵称 / 邮箱</span>
				<input
					type="text"
					name="email"
					autocomplete="username"
					required
					placeholder="you@example.com"
					data-login-email
				>
			</label>

			<button type="submit" class="login-submit">
				<Icon name="tabler:login" />
				<span>进入后台</span>
			</button>

			<p class="login-note">
				<Icon name="tabler:alert-circle" />
				<span>
					本站为纯静态站点，此处<strong>不做真实鉴权</strong>（无后端可校验）。<br>
					它只是一次本地记录；真正的访问控制请在部署层（EdgeOne / 反向代理）
					对 <code>/admin/*</code> 设规则拦截。
				</span>
			</p>

			<p class="login-error" data-login-error hidden role="alert" />
		</form>
	</div>
</Base>

<script>
	import { ADMIN_SESSION_KEY, isValidSession } from '../../lib/admin'

	function readSession() {
		try {
			const raw = sessionStorage.getItem(ADMIN_SESSION_KEY)
			if (!raw)
				return null
			const parsed = JSON.parse(raw)
			return isValidSession(parsed) ? parsed : null
		}
		catch {
			return null
		}
	}

	function initLoginForm() {
		const form = document.querySelector('[data-login-form]')
		if (!(form instanceof HTMLFormElement) || form.dataset.loginReady)
			return
		form.dataset.loginReady = '1'

		// 已登录直接回后台（尊重 ?next 的回跳地址）
		const session = readSession()
		const next = new URLSearchParams(location.search).get('next') || '/admin/'
		if (session) {
			location.replace(next)
			return
		}

		const emailInput = form.querySelector('[data-login-email]')
		const error = form.querySelector('[data-login-error]')

		form.addEventListener('submit', (e) => {
			e.preventDefault()
			const email = (emailInput instanceof HTMLInputElement ? emailInput.value : '').trim()
			if (!email) {
				if (error instanceof HTMLElement) {
					error.textContent = '请先填写昵称或邮箱'
					error.hidden = false
				}
				return
			}
			try {
				sessionStorage.setItem(ADMIN_SESSION_KEY, JSON.stringify({ email, at: Date.now() }))
			}
			catch {
				// 隐私模式下 storage 可能不可写；仍然放行（本地门禁，不阻断体验）
			}
			location.href = next
		})
	}

	if (document.readyState === 'loading')
		document.addEventListener('DOMContentLoaded', initLoginForm)
	else
		initLoginForm()
	document.addEventListener('astro:page-load', initLoginForm)
</script>

<style>
.login-shell {
	display: grid;
	place-items: center;
	min-height: 100vh;
	padding: 1.5rem;
	background: var(--c-bg-1);
	color: var(--c-text);
}

.login-card {
	width: min(26rem, 100%);
	display: flex;
	flex-direction: column;
	gap: 0.7rem;
	padding: 2rem 1.6rem;
	border: 1px solid var(--c-border);
	border-radius: 0.9rem;
	background: var(--c-bg);
	box-shadow: var(--box-shadow-1);
}

.login-icon {
	font-size: 1.6rem;
	color: var(--c-primary);
}

.login-title {
	margin: 0;
	font-size: 1.1rem;
}

.login-sub {
	margin: 0;
	color: var(--c-text-2);
	font-size: 0.9rem;
}

.field {
	display: flex;
	flex-direction: column;
	gap: 0.35rem;
	margin-top: 0.6rem;

	.field-label {
		font-size: 0.82rem;
		color: var(--c-text-2);
	}

	input {
		padding: 0.6rem 0.7rem;
		border: 1px solid var(--c-border);
		border-radius: 0.5rem;
		background: var(--c-bg-1);
		color: inherit;
		font: inherit;

		&:focus-visible {
			outline: 2px solid var(--c-primary);
			outline-offset: 1px;
		}
	}
}

.login-submit {
	display: inline-flex;
	gap: 0.5rem;
	align-items: center;
	justify-content: center;
	margin-top: 0.9rem;
	padding: 0.65rem 1rem;
	border: none;
	border-radius: 0.5rem;
	background: var(--c-primary);
	color: var(--c-bg);
	font: inherit;
	font-weight: 600;
	cursor: pointer;

	&:hover {
		filter: brightness(1.05);
	}
}

.login-note {
	display: flex;
	gap: 0.5rem;
	align-items: flex-start;
	margin: 0.4rem 0 0;
	padding: 0.7rem 0.8rem;
	border-radius: 0.5rem;
	background: var(--c-warning-soft);
	color: var(--c-text-1);
	font-size: 0.78rem;
	line-height: 1.5;

	code {
		padding: 0.05em 0.3em;
		border-radius: 0.25rem;
		background: var(--c-bg-soft);
		font-family: var(--font-mono, monospace);
	}
}

.login-error {
	margin: 0;
	color: var(--c-error);
	font-size: 0.85rem;

	&[hidden] {
		display: none;
	}
}
</style>