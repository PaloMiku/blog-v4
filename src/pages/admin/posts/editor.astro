---
/**
 * 后台编辑器：编辑单篇文章的 frontmatter + MDX 正文。
 *
 * ## 定位（重要）
 * 本站是**纯静态 SSG**，没有写内容的 API。因此本编辑器**不直接改仓库**：
 * 它做的是「本地起草 + 导出」——
 *   1. 打开 `/admin/posts/editor?id=<文章 id>` 时，按 id 取回该文的**原始 body**
 *      （内容集合保留了 `body`，含 frontmatter 原文 + 正文，见 content.config / loaders）；
 *   2. 编辑实时在浏览器里进行，并**自动存一份草稿到 localStorage**
 *      （刷新/误关不丢；键见 `lib/admin.ts` 的 draftKey）；
 *   3. 点「导出 .mdx」下载一个完整的 `.mdx` 文件，作者把它放进
 *      `src/content/posts/<年>/`，走正常 `pnpm build` 发布。
 *
 * 「保存」= 存本地草稿；「发布」= 导出并提交。UI 上据实区分，不假装能直连仓库。
 *
 * ## 取正文的三条来源（优先级从上到下）
 *   1. URL 的 `?id=` 对应文章的构建期原始 body（编辑既有文章的主路径）；
 *   2. localStorage 草稿（有人正在编辑、或上次没导出）；
 *   3. 空模板（写新文章 / id 无效）。
 * 构建期把所有文章的 `{ id, title, body }` 以 JSON 内联进页面
 * （`data-editor-payload`），避免再请求一个端点——文章量级仅几十，够用。
 */
import AdminLayout from '../../../layouts/AdminLayout.astro'
import Icon from '../../../components/Icon.astro'
import { getAllContent } from '../../../lib/content'
import blogConfig from '../../../config/blog'

// 取全部文章的 id / title / body，内联给编辑器做客户端查找与回填。
// body 已由内容层保留（含 frontmatter 原文），这里只带编辑必需的最小字段。
/**
 * ⚠️ `entry.body` 是**去掉 frontmatter 之后**的正文（Astro 在解析时已剥离），
 * 所以正文与属性必须分两个来源拿：
 *   - 属性 ← `entry.data`：内容 schema 已校验过的结构化 frontmatter（权威来源）
 *   - 正文 ← `entry.body`：MDX 正文本体
 * 早先的版本试图从 `body` 里 `splitFrontMatter` 解析属性，而 body 里根本没有
 * frontmatter，于是**打开既有文章时标题等字段全是空的**（实测 takagi 篇复现）。
 */
const payload = (await getAllContent())
	.filter(e => e.data.isPost)
	.map(e => ({
		id: e.id,
		title: e.data.title ?? e.id,
		body: e.body ?? '',
		data: {
			title: e.data.title,
			subtitle: e.data.subtitle,
			description: e.data.description,
			date: e.data.date,
			updated: e.data.updated,
			categories: e.data.categories,
			tags: e.data.tags,
			type: e.data.type,
			recommend: e.data.recommend,
			permalink: e.data.permalink,
			draft: e.data.draft,
		},
	}))

/**
 * 内联 JSON 必须转义 `<` / `>` / `&`，否则正文里出现 `</script>` 会**提前闭合**
 * 包裹它的 <script> 标签——既破坏数据，也会变成注入点。
 * 仓库里确实有这种正文（`2024/12/oyiso-tianligpt`、`2025/10/clarity-resource-list`
 * 都内嵌了 </script>），故这里把三个字符写成 JSON 的 \uXXXX 转义：
 * HTML 解析器看不到它们，`JSON.parse` 仍会还原成原字符。
 */
const payloadJson = JSON.stringify(payload).replace(
	/[<>&\u2028\u2029]/g,
	ch => `\\u${ch.charCodeAt(0).toString(16).padStart(4, '0')}`,
)

const types = Object.keys(blogConfig.article.types)
const categoryNames = Object.keys(blogConfig.article.categories)
---

<AdminLayout title="写文章" active="editor">
	<div class="editor-toolbar">
		<div class="editor-target">
			<label class="field-inline">
				<span>编辑对象</span>
				<select data-editor-target>
					<option value="">＋ 新建文章</option>
					{payload.map(p => <option value={p.id}>{p.title}</option>)}
				</select>
			</label>
		</div>

		<div class="editor-actions">
			<span class="save-state" data-save-state aria-live="polite" />
			<button type="button" class="btn" data-editor-load-draft hidden>恢复本地草稿</button>
			<button type="button" class="btn" data-editor-export>
				<Icon name="tabler:download" />
				<span>导出 .mdx</span>
			</button>
		</div>
	</div>

	<p class="editor-hint">
		<Icon name="tabler:info-circle" />
		<span>
			纯静态站点无法直写仓库：<strong>「保存」= 存本地草稿</strong>，
			<strong>「导出」= 下载 .mdx</strong>，放进 <code>src/content/posts/&lt;年&gt;/</code> 后提交即可发布。
		</span>
	</p>

	<div class="editor-grid">
		<section class="editor-fields" aria-label="文章属性">
			<h2 class="fields-title">属性</h2>

			<label class="field">
				<span class="field-label">标题</span>
				<input type="text" data-f="title" placeholder="文章标题（列表与 RSS 用它）">
			</label>

			<label class="field">
				<span class="field-label">副标题</span>
				<input type="text" data-f="subtitle" placeholder="可选，显示在标题下方">
			</label>

			<label class="field">
				<span class="field-label">摘要</span>
				<textarea data-f="description" rows="3" placeholder="SEO 描述 / 列表摘要" />
			</label>

			<div class="field-row">
				<label class="field">
					<span class="field-label">创建日期</span>
					<input type="text" data-f="date" placeholder="YYYY-MM-DD HH:mm:ss">
				</label>
				<label class="field">
					<span class="field-label">更新日期</span>
					<input type="text" data-f="updated" placeholder="留空表示未更新">
				</label>
			</div>

			<label class="field">
				<span class="field-label">分类（第一个作一级分类）</span>
				<input type="text" data-f="categories" list="admin-categories" placeholder="逗号分隔">
				<datalist id="admin-categories">
					{categoryNames.map(c => <option value={c} />)}
				</datalist>
			</label>

			<label class="field">
				<span class="field-label">标签</span>
				<input type="text" data-f="tags" placeholder="逗号分隔">
			</label>

			<div class="field-row">
				<label class="field">
					<span class="field-label">版式</span>
					<select data-f="type">
						<option value="">默认</option>
						{types.map(t => <option value={t}>{t}</option>)}
					</select>
				</label>
				<label class="field">
					<span class="field-label">推荐权重</span>
					<input type="number" data-f="recommend" placeholder="仅精选用" min="0">
				</label>
			</div>

			<label class="field">
				<span class="field-label">自定义链接</span>
				<input type="text" data-f="permalink" placeholder="留空则用 /posts/… 形式">
			</label>

			<label class="checkbox">
				<input type="checkbox" data-f="draft">
				<span>草稿（不进入列表与订阅源）</span>
			</label>
		</section>

		<section class="editor-body" aria-label="正文">
			<div class="body-head">
				<h2 class="fields-title">正文（MDX）</h2>
				<span class="body-stats" data-body-stats />
			</div>
			<textarea
				class="body-input"
				data-editor-body
				spellcheck="false"
				placeholder="在这里写 MDX 正文……"
			/>
		</section>
	</div>

	<script type="application/json" data-editor-payload set:html={payloadJson} />
</AdminLayout>

<script>
	import {
		composeMdx,
		draftKey,
		emptyFrontMatter,
		estimateReading,
		formatListInput,
		parseListInput,
		resolveExportSlug,
	} from '../../../lib/admin'

	function readPayload() {
		const el = document.querySelector('[data-editor-payload]')
		if (!el)
			return []
		try {
			return JSON.parse(el.textContent || '[]')
		}
		catch {
			return []
		}
	}

	function initEditor() {
		const body = document.querySelector('[data-editor-body]')
		const target = document.querySelector('[data-editor-target]')
		const statsEl = document.querySelector('[data-body-stats]')
		const saveState = document.querySelector('[data-save-state]')
		const loadDraftBtn = document.querySelector('[data-editor-load-draft]')
		const exportBtn = document.querySelector('[data-editor-export]')
		if (!(body instanceof HTMLTextAreaElement) || !(target instanceof HTMLSelectElement))
			return
		if (body.dataset.editorReady)
			return
		body.dataset.editorReady = '1'

		const fields = new Map<string, HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>()
		for (const el of document.querySelectorAll('[data-f]')) {
			const key = el.dataset.f
			if (key && (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || el instanceof HTMLSelectElement))
				fields.set(key, el)
		}

		const LIST_KEYS = new Set(['categories', 'tags'])
		const NUMBER_KEYS = new Set(['recommend'])
		const BOOL_KEYS = new Set(['draft'])

		function currentId() {
			return target.value
		}

		function collect(): Record<string, any> {
			const out: Record<string, any> = {}
			for (const [key, el] of fields) {
				if (BOOL_KEYS.has(key)) {
					out[key] = (el as HTMLInputElement).checked
					continue
				}
				const raw = (el as HTMLInputElement).value ?? ''
				if (LIST_KEYS.has(key)) {
					out[key] = parseListInput(raw)
					continue
				}
				if (NUMBER_KEYS.has(key)) {
					if (raw.trim() === '')
						continue
					const n = Number(raw)
					if (!Number.isNaN(n))
						out[key] = n
					continue
				}
				out[key] = raw
			}
			return out
		}

		function fill(data: Record<string, any>) {
			for (const [key, el] of fields) {
				const v = data[key]
				if (BOOL_KEYS.has(key)) {
					(el as HTMLInputElement).checked = Boolean(v)
					continue
				}
				const text = LIST_KEYS.has(key)
					? formatListInput(v as string[])
					: v === undefined || v === null ? '' : String(v)
				;(el as HTMLInputElement).value = text
			}
		}

		function updateStats() {
			if (statsEl)
				statsEl.textContent = `约 ${estimateReading(body.value).words} 字 · ${estimateReading(body.value).minutes} 分钟`
		}

		// —— 本地草稿 ——
		function saveDraft() {
			const data = collect()
			try {
				localStorage.setItem(draftKey(currentId()), JSON.stringify({ data, body: body.value, at: Date.now() }))
				if (saveState) {
					saveState.textContent = '草稿已存'
					saveState.dataset.state = 'ok'
				}
			}
			catch {
				if (saveState) {
					saveState.textContent = '无法写入本地存储'
					saveState.dataset.state = 'error'
				}
			}
		}

		function hasDraft(id: string) {
			try {
				return Boolean(localStorage.getItem(draftKey(id)))
			}
			catch {
				return false
			}
		}

		function loadArticle(id: string) {
			if (!id) {
				fill(emptyFrontMatter())
				body.value = ''
				updateStats()
				return
			}
			const entry = readPayload().find((p: any) => p.id === id)
			// 已有本地草稿优先提示恢复，不静默覆盖作者正在写的内容
			if (hasDraft(id) && loadDraftBtn instanceof HTMLElement) {
				loadDraftBtn.hidden = false
			}
			fill({ ...emptyFrontMatter(), ...(entry?.data ?? {}) })
			body.value = String(entry?.body ?? '').trim()
			updateStats()
		}

		// —— 事件绑定 ——
		let saveTimer: number | undefined
		function scheduleSave() {
			if (saveTimer)
				clearTimeout(saveTimer)
			saveTimer = setTimeout(saveDraft, 500) as unknown as number
		}

		target.addEventListener('change', () => {
			loadArticle(target.value)
			if (saveState) {
				saveState.textContent = ''
				saveState.removeAttribute('data-state')
			}
		})

		body.addEventListener('input', () => {
			updateStats()
			scheduleSave()
		})
		for (const el of fields.values())
			el.addEventListener('input', scheduleSave)

		loadDraftBtn?.addEventListener('click', () => {
			try {
				const raw = localStorage.getItem(draftKey(currentId()))
				if (!raw)
					return
				const parsed = JSON.parse(raw)
				fill(parsed.data ?? {})
				body.value = parsed.body ?? ''
				updateStats()
				if (saveState)
					saveState.textContent = '已恢复草稿'
			}
			catch { /* 草稿损坏则忽略，保留当前编辑框内容 */ }
		})

		exportBtn?.addEventListener('click', () => {
			const data = collect()
			// 标题为空且不是编辑既有文章 → 拒绝导出，避免产出无意义的 untitled.mdx；
			// 与既有文章重名 → 自动加 -2 后缀，避免放进 content 后静默覆盖前者。
			const { slug, error, deduplicated } = resolveExportSlug({
				title: String(data.title ?? ''),
				id: currentId(),
				existingIds: readPayload().map((p: any) => p.id),
			})
			if (error) {
				if (saveState) {
					saveState.textContent = error
					saveState.dataset.state = 'error'
				}
				return
			}
			const file = composeMdx(data, body.value)
			const blob = new Blob([file], { type: 'text/markdown;charset=utf-8' })
			const url = URL.createObjectURL(blob)
			const a = document.createElement('a')
			a.href = url
			a.download = `${slug}.mdx`
			a.click()
			URL.revokeObjectURL(url)
			saveDraft()
			if (saveState) {
				saveState.textContent = deduplicated
					? `已导出为 ${slug}.mdx（已重名，文件名加了序号），请提交进 src/content`
					: `已导出 ${slug}.mdx，请提交进 src/content`
				saveState.dataset.state = 'ok'
			}
		})

		// 初始化：URL ?id= 优先，其次第一篇（若有），否则空模板
		const id = new URLSearchParams(location.search).get('id') ?? ''
		if (id) {
			target.value = id
			loadArticle(id)
		}
		else {
			loadArticle('')
		}
	}

	if (document.readyState === 'loading')
		document.addEventListener('DOMContentLoaded', initEditor)
	else
		initEditor()
	document.addEventListener('astro:page-load', initEditor)
</script>

<style>
.editor-toolbar {
	display: flex;
	flex-wrap: wrap;
	gap: 0.7rem;
	align-items: end;
	justify-content: space-between;
	margin-bottom: 0.8rem;
}

.field-inline {
	display: inline-flex;
	gap: 0.5rem;
	align-items: center;
	font-size: 0.85rem;
	color: var(--c-text-2);

	select {
		min-width: 16rem;
	}
}

.editor-actions {
	display: inline-flex;
	gap: 0.5rem;
	align-items: center;
	flex-wrap: wrap;
}

.save-state {
	font-size: 0.8rem;
	color: var(--c-text-3);

	&[data-state='ok'] {
		color: var(--c-success);
	}

	&[data-state='error'] {
		color: var(--c-error);
	}
}

.btn {
	display: inline-flex;
	gap: 0.4rem;
	align-items: center;
	padding: 0.5rem 0.9rem;
	border: 1px solid var(--c-border);
	border-radius: 0.5rem;
	background: var(--c-bg);
	color: inherit;
	font: inherit;
	cursor: pointer;

	&:hover {
		border-color: var(--c-primary);
		color: var(--c-primary);
	}
}

.editor-hint {
	display: flex;
	gap: 0.5rem;
	align-items: flex-start;
	margin: 0 0 1rem;
	padding: 0.6rem 0.8rem;
	border-radius: 0.5rem;
	background: var(--c-primary-soft);
	font-size: 0.8rem;
	line-height: 1.5;

	code {
		padding: 0.05em 0.3em;
		border-radius: 0.25rem;
		background: var(--c-bg-soft);
	}
}

.editor-grid {
	display: grid;
	grid-template-columns: 20rem 1fr;
	gap: 1rem;
	align-items: start;

	@media (width <= 64rem) {
		grid-template-columns: 1fr;
	}
}

.editor-fields,
.editor-body {
	border: 1px solid var(--c-border);
	border-radius: 0.7rem;
	background: var(--c-bg);
	padding: 1rem;
}

.fields-title {
	margin: 0 0 0.8rem;
	font-size: 0.9rem;
}

.editor-fields {
	display: flex;
	flex-direction: column;
	gap: 0.7rem;
}

.field {
	display: flex;
	flex-direction: column;
	gap: 0.3rem;

	.field-label {
		font-size: 0.78rem;
		color: var(--c-text-2);
	}

	input,
	textarea,
	select {
		width: 100%;
		padding: 0.45rem 0.6rem;
		border: 1px solid var(--c-border);
		border-radius: 0.45rem;
		background: var(--c-bg-1);
		color: inherit;
		font: inherit;

		&:focus-visible {
			outline: 2px solid var(--c-primary);
			outline-offset: 1px;
		}
	}

	textarea {
		resize: vertical;
	}
}

.field-row {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 0.6rem;
}

.checkbox {
	display: inline-flex;
	gap: 0.45rem;
	align-items: center;
	font-size: 0.85rem;
	color: var(--c-text-1);
}

.body-head {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 1rem;
}

.body-stats {
	color: var(--c-text-3);
	font-size: 0.78rem;
}

.body-input {
	width: 100%;
	min-height: 60vh;
	margin-top: 0.5rem;
	padding: 0.8rem;
	border: 1px solid var(--c-border);
	border-radius: 0.5rem;
	background: var(--c-bg-1);
	color: inherit;
	font-family: var(--font-mono, ui-monospace, monospace);
	font-size: 0.85rem;
	line-height: 1.6;
	resize: vertical;
	tab-size: 2;

	&:focus-visible {
		outline: 2px solid var(--c-primary);
		outline-offset: 1px;
	}
}
</style>