---
/**
 * 后台文章列表：搜索 + 按分类/状态筛选 + 排序。
 *
 * ## 数据流
 * 列表在**构建期**从内容集合渲染成 DOM（无 JS 也能看到全部文章），
 * 搜索/筛选是**客户端**行为：按 `data-*` 里的字段就地 `hidden` 切换。
 * 这与归档页 `OrderToggle` 的既有约定一致——组件产出状态，页面重排 DOM。
 *
 * 每行链接到 `/admin/posts/editor?id=<id>`，编辑器据 `id` 取正文。
 */
import AdminLayout from '../../../layouts/AdminLayout.astro'
import Icon from '../../../components/Icon.astro'
import { categorizeArticles, getAllContent } from '../../../lib/content'

const entries = (await getAllContent()).filter(e => e.data.isPost)

// 默认按创建日期倒序（与归档页默认一致）
const sorted = [...entries].sort((a, b) => (b.data.date ?? '').localeCompare(a.data.date ?? ''))

const { categories } = categorizeArticles(sorted)

// @keep-sorted
const statuses = [
	{ key: '', label: '全部' },
	{ key: 'published', label: '已发布' },
	{ key: 'draft', label: '草稿' },
] as const
---

<AdminLayout title="文章" active="posts">
	<div class="list-toolbar" data-list-root>
		<label class="search">
			<Icon name="tabler:search" />
			<input type="search" placeholder="搜索标题 / 标签 / 分类…" data-list-search>
		</label>

		<div class="filters">
			<select data-list-category aria-label="按分类筛选">
				<option value="">全部分类</option>
				{categories.map(cat => <option value={cat}>{cat}</option>)}
			</select>

			<div class="segmented" role="group" aria-label="按状态筛选">
				{statuses.map(s => (
					<button
						type="button"
						class="segment"
						class:list={{ active: s.key === '' }}
						data-list-status={s.key}
					>
						{s.label}
					</button>
				))}
			</div>
		</div>
	</div>

	<p class="list-count" data-list-count aria-live="polite" />

	<ul class="post-list" data-list-items>
		{sorted.map(post => {
			const id = post.id
			const cat = post.data.categories?.[0] ?? ''
			const haystack = [post.data.title ?? '', id, cat, ...(post.data.tags ?? [])].join(' ').toLowerCase()
			return (
				<li
					class="post-row"
					data-post-row
					data-id={id}
					data-title={(post.data.title ?? id).toLowerCase()}
					data-category={cat}
					data-tags={(post.data.tags ?? []).join(' ').toLowerCase()}
					data-draft={post.data.draft ? '1' : '0'}
					data-haystack={haystack}

				>
					<a class="post-main" href={`/admin/posts/editor?id=${encodeURIComponent(id)}`}>
						<span class="post-title">
							{post.data.title ?? id}
							{post.data.draft && <span class="badge draft">草稿</span>}
						</span>
						<span class="post-meta">
							<span class="post-id">{id}</span>
							{cat && <span class="post-cat">{cat}</span>}
							<span class="post-date">{post.data.date ?? '—'}</span>
						</span>
					</a>
					<span class="post-words">{post.data.readingTime?.words ?? 0} 字</span>
					<span class="row-actions">
						<a class="icon-btn" href={`/admin/posts/editor?id=${encodeURIComponent(id)}`} title="编辑">
							<Icon name="tabler:pencil" />
						</a>
						<a class="icon-btn" href={`/${id}`} title="查看线上页面">
							<Icon name="tabler:eye" />
						</a>
					</span>
				</li>
			)
		})}
	</ul>

	<p class="list-empty" data-list-empty hidden>没有匹配的文章</p>
</AdminLayout>

<script>
	function initPostList() {
		const root = document.querySelector('[data-list-root]')
		if (!(root instanceof HTMLElement) || root.dataset.listReady)
			return
		root.dataset.listReady = '1'

		const search = document.querySelector('[data-list-search]')
		const category = document.querySelector('[data-list-category]')
		const count = document.querySelector('[data-list-count]')
		const empty = document.querySelector('[data-list-empty]')
		const rows = [...document.querySelectorAll('[data-post-row]')]
		const segments = [...document.querySelectorAll('[data-list-status]')]

		let status = ''

		function apply() {
			const q = (search instanceof HTMLInputElement ? search.value : '').trim().toLowerCase()
			const cat = category instanceof HTMLSelectElement ? category.value : ''
			let visible = 0

			for (const row of rows) {
				if (!(row instanceof HTMLElement))
					continue
				const matchQ = !q || (row.dataset.haystack ?? '').includes(q)
				const matchCat = !cat || row.dataset.category === cat
				const isDraft = row.dataset.draft === '1'
				const matchStatus = !status || (status === 'draft' ? isDraft : !isDraft)
				const show = matchQ && matchCat && matchStatus
				row.hidden = !show
				if (show)
					visible++
			}

			if (count)
				count.textContent = `${visible} / ${rows.length} 篇`
			if (empty instanceof HTMLElement)
				empty.hidden = visible !== 0
		}

		search?.addEventListener('input', apply)
		category?.addEventListener('change', apply)

		for (const seg of segments) {
			seg.addEventListener('click', () => {
				status = seg.dataset.listStatus ?? ''
				for (const s of segments)
					s.classList.toggle('active', s === seg)
				apply()
			})
		}

		apply()
	}

	if (document.readyState === 'loading')
		document.addEventListener('DOMContentLoaded', initPostList)
	else
		initPostList()
	document.addEventListener('astro:page-load', initPostList)
</script>

<style>
.list-toolbar {
	display: flex;
	flex-wrap: wrap;
	gap: 0.7rem;
	align-items: center;
	margin-bottom: 0.9rem;
}

.search {
	display: inline-flex;
	gap: 0.45rem;
	align-items: center;
	flex: 1 1 16rem;
	padding: 0.45rem 0.7rem;
	border: 1px solid var(--c-border);
	border-radius: 0.5rem;
	background: var(--c-bg);
	color: var(--c-text-2);

	input {
		flex: 1;
		min-width: 0;
		border: none;
		outline: none;
		background: none;
		color: inherit;
		font: inherit;
	}
}

.filters {
	display: inline-flex;
	gap: 0.5rem;
	align-items: center;
	flex-wrap: wrap;
}

select {
	padding: 0.45rem 0.6rem;
	border: 1px solid var(--c-border);
	border-radius: 0.5rem;
	background: var(--c-bg);
	color: inherit;
	font: inherit;
}

.segmented {
	display: inline-flex;
	border: 1px solid var(--c-border);
	border-radius: 0.5rem;
	overflow: hidden;
}

.segment {
	padding: 0.45rem 0.8rem;
	border: none;
	background: var(--c-bg);
	color: var(--c-text-2);
	font: inherit;
	cursor: pointer;

	& + .segment {
		border-inline-start: 1px solid var(--c-border);
	}

	&.active {
		background: var(--c-primary-soft);
		color: var(--c-primary);
		font-weight: 600;
	}
}

.list-count {
	margin: 0 0 0.6rem;
	color: var(--c-text-3);
	font-size: 0.8rem;
}

.post-list {
	list-style: none;
	margin: 0;
	padding: 0;
	border: 1px solid var(--c-border);
	border-radius: 0.7rem;
	background: var(--c-bg);
	overflow: hidden;
}

.post-row {
	display: grid;
	grid-template-columns: 1fr auto auto;
	gap: 0.8rem;
	align-items: center;
	padding: 0.7rem 0.9rem;

	& + & {
		border-top: 1px solid var(--c-border);
	}

	&[hidden] {
		display: none;
	}

	&:hover {
		background: var(--c-bg-1);
	}
}

.post-main {
	display: flex;
	flex-direction: column;
	gap: 0.2rem;
	min-width: 0;
	color: inherit;
	text-decoration: none;
}

.post-title {
	display: inline-flex;
	gap: 0.4rem;
	align-items: center;
	font-weight: 600;
	overflow: hidden;
	white-space: nowrap;
	text-overflow: ellipsis;
}

.badge {
	padding: 0.05rem 0.4rem;
	border-radius: 0.999px;
	font-size: 0.7rem;
	font-weight: 600;

	&.draft {
		background: var(--c-warning-soft);
		color: var(--c-warning);
	}
}

.post-meta {
	display: inline-flex;
	gap: 0.6rem;
	color: var(--c-text-3);
	font-size: 0.78rem;
	flex-wrap: wrap;

	.post-cat {
		color: var(--c-text-2);
	}
}

.post-words {
	color: var(--c-text-3);
	font-size: 0.78rem;
	font-variant-numeric: tabular-nums;
	white-space: nowrap;
}

.row-actions {
	display: inline-flex;
	gap: 0.2rem;
}

.icon-btn {
	display: inline-grid;
	place-items: center;
	width: 1.9rem;
	height: 1.9rem;
	border-radius: 0.4rem;
	color: var(--c-text-3);
	text-decoration: none;

	&:hover {
		background: var(--c-bg-2);
		color: var(--c-primary);
	}
}

.list-empty {
	padding: 1.6rem;
	text-align: center;
	color: var(--c-text-3);

	&[hidden] {
		display: none;
	}
}
</style>