 */
.settings-reset {
	padding: 0.4em 1em;
	border: 1px solid transparent;
	border-radius: 0.5em;
	color: var(--c-text-2);
	transition: background-color 0.2s, border-color 0.2s, color 0.2s;

	&:hover {
		border-color: var(--c-primary);
		background-color: var(--c-bg-soft);
		color: var(--c-text);
	}

	/*
	 * 禁用态必须**同时**去掉 hover 反馈：只降透明度的话鼠标移上去还会
