}

/*
 * `Slider.astro` 的 `.z-slider` 只有 `display: flex`，**没有 `flex-grow`**——
 * 它设计时被放进一个本来就占满整行的容器里。直接塞进本组件的 flex 容器就会
 * 按内容宽度收缩，于是滑块只有一百来像素宽。
 *
 * 用 `:global()` 而不是本组件的 `.settings-slider`：那个 class 是作为 prop 传给
 * `Slider` 的，落在**它自己那份 scope** 的根元素上；不加 `:global()` 会要求元素
 * 同时带两份 scope id 而永不匹配（与 `BlogSidebar.astro:556-568` 同一个坑）。
 */
:global(.settings-slider) {
	flex-grow: 1;
	min-width: 0;
}

.settings-unit {
	color: var(--c-text-2);
}

.settings-select-trigger {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 0.5em;
	width: 100%;
	padding: 0.35em 0.8em;
	border: 1px solid var(--c-border-strong);
	border-radius: 0.5em;
	text-align: start;
	color: var(--c-text-1);
	transition: border-color 0.2s;

	&:hover {
		border-color: var(--c-primary);
	}
}

.settings-select-icon {
	display: block;
	width: 1em;
	height: 1em;
	color: var(--c-text-2);
}

/* 色相对比度提示：贴在控件下方，是「这一项的近况」而不是又一段说明 */
.settings-note {
	max-width: 22rem;
	margin: 0.2em 0 0;
	font-size: 0.8em;
	text-align: end;
	color: var(--c-text-3);

	&[data-low='true'] {
		color: var(--c-text-1);
	}
}

/*
 * Slider 的内部节点（`input.input-slider`）带的是 **Slider.astro 自己的**
 * scope id，不是本组件的——不加 `:global()` 编译出来会要求两个 id 同时存在，
 * 永不匹配（与 `BlogSidebar.astro:556-568` 记的是同一个坑）。
 *
 * ⚠️ 色相轨道的两条背景**只在 Chromium/WebKit 生效**：原生 `<input type=range>`
 * 在 Firefox 下由 appearance 渲染，不吃 `background-image`（Slider.astro:196
 * 那条 `@supports (-moz-appearance: auto)` 分支正说明了这一点）。
 * 所以对比度提示**不能只靠这条轨道**，上面那段文字是等效的第二通道。
 */
:global(.settings-slider.setting-hue .input-slider[type='range']) {
	/*
	 * 两条渐变叠在一起：底层是色相光谱，顶层把低对比区压暗。
	 * `--band-*` 的百分比按 thumb 半径折算过——thumb 直径等于 input 高度 1.2em，
	 * 于是 thumb 中心只走过 `[0.6em, 100% - 0.6em]` 这一段，
	 * 直接用 `20/360` 会让整个警示区偏移 1.2em。
	 */
	--band-start: calc(0.6em + (100% - 1.2em) * 0.055556);
	--band-end: calc(0.6em + (100% - 1.2em) * 0.569444);

	background-image:
		linear-gradient(
			to right,
			#0009 0 var(--band-start),
			#0000 var(--band-start) var(--band-end),
			#0009 var(--band-end) 100%
		),
		linear-gradient(
			to right,
			hsl(0 100% 70%), hsl(60 100% 70%), hsl(120 100% 70%),
			hsl(180 100% 70%), hsl(240 100% 70%), hsl(300 100% 70%), hsl(360 100% 70%)
		);
}

