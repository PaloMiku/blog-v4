---
/**
 * 手柄大屏模式的常驻 Shell：状态提示、顶部动作、底部动态键帽、设置面板，
 * 以及把「输入 → 动作」协调起来的客户端脚本。
 *
 * ## 职责边界（spec §运行时架构）
 * Shell **不渲染任何内容**，它只在现有 DOM 之上叠一层属性与控件：
 * 内容、区域标记、列表 key 都由页面自己声明（Task 7），交互语义由
 * `gamepad-input.ts`（纯映射）→ `gamepad.ts`（设备生命周期）→
 * `gamepad-focus.ts`（焦点）三层给出，本文件是它们之间唯一的接线点。
 *
 * ## 契约（Task 6 的 CSS 与 Task 7 的页面都绑到这几个属性上）
 * - `data-big-picture-shell` —— Shell 根
 * - `data-big-picture-prompt` —— 连接提示（普通模式可见，鼠标可读的那条路）
 * - `data-big-picture-status` —— 状态条（断开 / 不支持 / 存储异常的可读提示）
 * - `data-big-picture-settings` —— 设置面板
 * - `data-big-picture-action="open-nav|open-aside|open-settings|exit"` —— 顶部动作
 * - `data-gamepad-region="overlay"` —— 顶部动作区与设置面板
 * - `data-gamepad-region="footer"` —— 底部键帽
 * 另有三个钩子属性（本层与焦点层之间的私有约定，不属于对外契约）：
 * `data-big-picture-hints`、`data-big-picture-hint="<键位>"`、`data-big-picture-page`。
 *
 * ## 为什么「B 关哪一层」不写在这里
 * 规格要求 B 的层级优先级可被钉死，而 `.astro` 的 `<script>` 无法被 Node 测试导入。
 * 于是判定搬进 `big-picture-state.ts` 的纯函数 `resolveBackLayer()`，
 * 本文件只负责把真实 DOM 翻译成快照、再按返回值调用**现有的**公开入口
 * （`closeModal()` / `closeLayout()` / 导航）——规格那条「不能仅修改根属性」
 * 因此仍然成立：优先级是纯函数，执行走真实单例。
 *
 * ## 显隐策略（Task 6 之前唯一的「样式」）
 * 本任务不写任何 CSS，所以可见性一律走 `hidden` 属性：
 * - 顶部动作与底部键帽**只在模式激活时**出现（普通模式下整块不占空间，
 *   Shell 根因此在普通模式下高度为 0，不动现有布局几何）；
 * - 提示条、状态条与设置面板可以在普通模式出现——它们只在有话可说时
 *   （连上了手柄 / 手柄不支持 / 浏览器不支持 API）才显示，
 *   这正是规格要求的「保留可用的手动入口，显示可读提示」。
 */
import type { BigPicturePage } from '../../lib/big-picture-state'
import { BIG_PICTURE_PAGES } from '../../lib/big-picture-state'

interface Props {
	/** 本页的大屏页面类型。`'off'` = 本页停用增强但保留会话意图 */
	page: BigPicturePage
}

const { page: rawPage } = Astro.props

/*
 * 属性拼错不该把一个非法页面类型带进客户端——那会让「本页停用增强」这条兜底
 * 静默失效。写法上不用 `as` 断言强行通过，而是真的查一次白名单：
 * 非法值一律收敛成 `'off'`，也就是「什么都不接管」。
 */
const page: BigPicturePage = (BIG_PICTURE_PAGES as readonly string[]).includes(rawPage) ? rawPage : 'off'
---

<div class="big-picture-shell" data-big-picture-shell data-big-picture-page={page}>
	{/*
		连接提示。普通模式下唯一「说得清为什么要按手柄」的地方：
		部分浏览器要等用户先动手柄才暴露设备，所以它也得能被鼠标读到。
	*/}
	<p class="big-picture-prompt" data-big-picture-prompt role="status" hidden />

	{/*
		状态条。与提示条分开是因为二者出现条件不同：提示条只在「连上了、还没进模式」时
		出现，状态条说的是设备/能力问题（断开、不支持、浏览器没有 API）。
	*/}
	<p class="big-picture-status" data-big-picture-status role="status" hidden />

	{/*
		手动进入的兜底入口。**它不能依赖轮询**：手动退出会置「本标签页不再自动进入」，
		而输入层的门禁在抑制态下停轮询，于是这一状态下按任何键都不会进模式——
		规格为此专门留了「顶部或常规控制面板仍允许手动进入」这一句。
		显示条件由 `resolveShellView()` 裁决，只在「设备在、且被抑制」时出现；
		没接手柄的普通模式页面上它一直是 `hidden`。
	*/}
	<button
		class="big-picture-enter"
		type="button"
		data-big-picture-action="enter"
		data-big-picture-manual-entry
		hidden
	>进入大屏模式</button>

	<div class="big-picture-actions" data-gamepad-region="overlay" data-big-picture-actions hidden>
		{/*
			导航 / 目录开的是 `layout-state` 的两个抽屉。**刻意不写 `data-layout-toggle`**：
			那会把开关交给 `bindLayoutGlobals()` 的全局委托，于是同一个点击既被委托处理、
			又被本文件处理一次，两次 `toggleLayout()` 互相抵消。Shell 自己接管，
			顺带在开合时记住触发元素以便归还焦点。
		*/}
		<button type="button" data-big-picture-action="open-nav">导航</button>
		<button type="button" data-big-picture-action="open-aside" hidden>目录</button>
		<button type="button" data-big-picture-action="open-settings">设置</button>
		{/*
			`data-big-picture-exit` 让「退出大屏」在本脚本初始化之前也能工作：
			`big-picture-state.ts` 的 `bindBigPictureGlobals()` 已经在委托这个属性。
		*/}
		<button type="button" data-big-picture-action="exit" data-big-picture-exit>退出大屏</button>
	</div>

	<div
		class="big-picture-settings"
		data-big-picture-settings
		data-gamepad-region="overlay"
		role="group"
		aria-label="大屏模式设置"
		hidden
	>
		<label class="big-picture-setting">
			<input type="checkbox" data-big-picture-auto-entry checked />
			<span>首次按键自动进入</span>
		</label>
		<button type="button" data-big-picture-action="close-settings">返回</button>
	</div>

	{/*
		底部键帽。四个槽位是**静态渲染**的，脚本只改 `textContent`：
		客户端 `createElement` 建出来的节点没有 `data-astro-cid`，
		凡是带作用域的样式规则都命中不了（CLAUDE.md 坑位 4）。

		`data-gamepad-region="footer"` **不是**误留：契约里这一条要求键帽条声明
		`overlay|footer` 两个区域，而它自身没有可聚焦的子节点——键帽是纯展示，
		LB/RB 的区域循环按「这一区真有可选目标」筛选，所以它会被自然跳过，
		不会变成一个按了没反应的区域。站点真正的页脚由 Task 7 标成自己的 `footer` 区域。
	*/}
	<p class="big-picture-hints" data-gamepad-region="footer" data-big-picture-hints hidden>
		<span data-big-picture-hint="confirm">A 确认</span>
		<span data-big-picture-hint="back">B 返回</span>
		<span data-big-picture-hint="shoulder">LB/RB 切换区域</span>
		<span data-big-picture-hint="stick">右摇杆 滚动</span>
	</p>
</div>

<script>
	import { createGamepadFocusManager, readFocusTargetKey } from '../../lib/gamepad-focus'
	import { FOCUS_SELECTOR, REGION_ATTRIBUTE } from '../../lib/gamepad-focus'
	import { FOCUS_REGIONS } from '../../lib/gamepad-navigation'
	import { createGamepadController } from '../../lib/gamepad'
	import { getScrollDelta } from '../../lib/gamepad-input'
	import {
		bindBigPictureGlobals,
		enterBigPicture,
		exitBigPicture,
		getBigPictureLocalStorage,
		isAutoEntrySuppressed,
		readAutoEntryEnabled,
		readRestoreFocusKey,
		resolveBackLayer,
		resolvePageReturn,
		resolveShellView,
		subscribeBigPicture,
		writeAutoEntryEnabled,
		writeRestoreFocusKey,
	} from '../../lib/big-picture-state'
	import { consumeNavigationSource, recordNavigationSource } from '../../lib/big-picture-session'
	import { longestCssDuration } from '../../lib/big-picture/settings-timing'
	import { bindLayoutGlobals, closeLayout, getLayoutState, subscribeLayout, toggleLayout } from '../../lib/layout-state'
	import { bindModalGlobals, closeModal, getModalStack, MODAL_DEFAULT_DURATION, subscribeModals } from '../../lib/modal'

	/*
	 * 设置面板的退场时长**不写死在这里**：先读面板自己声明的 `transition-duration`，
	 * 读到 0 才退回 modal 家族共享的 `MODAL_DEFAULT_DURATION`。理由见
	 * `settingsCloseDelay()` 的注释——写死一个数只会在 Task 6 给面板加上更长的过渡时失配，
	 * 而失配的代价是「第二次 B 穿透到页面返回」，即一次意外的离站导航。
	 */

	/** 标记本 Shell 已被接线的元素（幂等守卫，与仓库里其它组件同一写法） */
	let shellEl = null
	let pageType = 'off'
	let manager = null
	let controller = null
	let disposers = []
	let active = false
	let settingsState = 'closed'
	let settingsTimer = 0
	/**
	 * 设置面板收起后的收尾函数（清定时器 + 摘 `transitionend` 监听 + 落回 `'closed'`）。
	 * 留成模块级状态，`leaveMode()` / `teardown()` 必须能把它叫醒：否则那个
	 * `transitionend` 监听会留在面板上，等下一次**别的**过渡结束时被误触发，
	 * 在模式已经退出的页面上改状态、抢焦点。
	 */
	let settingsFinish = null
	/** 上一次被本层标上 `overlay` 区域的弹层根，关闭时要把属性摘回去 */
	let markedModalRoot = null
	/** 关抽屉 / 关设置后要把焦点还给谁 */
	let drawerReturnTarget = null
	let settingsReturnTarget = null
	/** 本次会话里待恢复的焦点 key（从来源页返回时写下的） */
	let pendingFocusKey = ''
	/** 滚动容器缓存。签名不变就不重扫 DOM——右摇杆是每帧都来的电平量 */
	let scrollCache = { signature: '', element: null }
	/** 设备状态。与 `gamepad.ts` 的 `GamepadDeviceStatus` 同值，合法取值见 `resolveShellView()` */
	let device = 'none'
	/** 本页是否真的见到过设备。没见到过就不说「已断开」——那是凭空多出来的一条提示 */
	let everConnected = false

	function localStore() {
		return getBigPictureLocalStorage()
	}

	function sessionStore() {
		try {
			return typeof window === 'undefined' ? null : window.sessionStorage
		}
		catch {
			// 隐私模式是「取属性就抛」；`big-picture-session.ts` 会把 null 降级到内存
			return null
		}
	}

	function currentPath() {
		return typeof location === 'undefined' ? '/' : location.pathname
	}

	/** 去尾斜杠。与 `big-picture-state.ts` / `big-picture-session.ts` 同规则 */
	function normalizeRoute(path) {
		if (path === '/')
			return '/'
		return path.endsWith('/') ? path.slice(0, -1) : path
	}

	function toggle(node, visible) {
		if (node)
			node.toggleAttribute('hidden', !visible)
	}

	function query(selector) {
		return shellEl ? shellEl.querySelector(selector) : null
	}

	/* ── 提示与状态 ────────────────────────────────────────────── */

	/**
	 * 状态区整块重算。
	 *
	 * 「显示什么」整段交给纯函数 `resolveShellView()`，本函数只负责把结果落到 DOM 上。
	 * 之所以不留在本地：这里有一条会被文案掩盖的规格缺陷——手动退出之后轮询停摆，
	 * 此时若文案仍写「按 Menu 键」，用户照做却毫无反应，而**没有任何测试会红**。
	 * 把「设备状态 × 两个进入开关 → 文案与按钮」做成纯函数之后，
	 * 「任何状态下都不提示一个此刻做不到的动作」就成了一条可断言的规则。
	 */
	function renderStatus() {
		const view = resolveShellView({
			page: pageType,
			support: controller ? controller.getStatus().support : 'unsupported',
			device,
			active,
			suppressed: isAutoEntrySuppressed(),
			autoEntryEnabled: readAutoEntryEnabled(localStore()),
			everConnected,
		})

		const statusEl = query('[data-big-picture-status]')
		toggle(statusEl, Boolean(view.status))
		if (statusEl)
			statusEl.textContent = view.status

		const promptEl = query('[data-big-picture-prompt]')
		toggle(promptEl, Boolean(view.prompt))
		if (promptEl)
			promptEl.textContent = view.prompt

		// 手动进入的兜底入口：只在「设备在 + 被抑制」时出现，
		// 于是没接手柄的普通模式页面上它恒为 `hidden`，与今天的视觉完全一致
		toggle(query('[data-big-picture-manual-entry]'), view.manualEntry)

		toggle(query('[data-big-picture-actions]'), active)
		toggle(query('[data-big-picture-hints]'), active)
	}

	/* ── 层快照：B 的唯一事实源 ────────────────────────────────── */

	/** 当前是否有打开的下拉控件。`Dropdown.astro` 的开合状态只落在 DOM 上 */
	function openDropdownRoot() {
		const focused = manager ? manager.getCurrent() : null
		// 优先关「焦点所在的那个」下拉，其次关第一个打开的
		const roots = [...document.querySelectorAll('[data-dropdown-root][data-open]')]
		if (focused)
			return roots.find(root => root.contains(focused)) ?? roots[0] ?? null
		return roots[0] ?? null
	}

	function backSnapshot() {
		return {
			settings: settingsState,
			modalStack: getModalStack().map(entry => ({ key: entry.key, status: entry.status })),
			dropdownOpen: Boolean(openDropdownRoot()),
			drawerOpen: getLayoutState() !== 'none',
		}
	}

	/** B 键在当前层级下的实际文案 */
	function backLabel(layer) {
		if (layer === null)
			return 'B 关闭中…'
		if (layer === 'settings')
			return 'B 关闭设置'
		if (layer === 'modal')
			return 'B 关闭弹层'
		if (layer === 'dropdown')
			return 'B 关闭下拉'
		if (layer === 'drawer')
			return 'B 关闭抽屉'
		return pageType === 'home' ? 'B 退出大屏' : 'B 返回'
	}

	/**
	 * 底部键帽必须显示**当前实际动作**，因此每次重算都用的是同一份
	 * `backSnapshot()` 与当前焦点上下文，而不是一组写死的标签。
	 */
	function renderHints() {
		const hintsEl = query('[data-big-picture-hints]')
		if (!hintsEl)
			return
		const layer = resolveBackLayer(backSnapshot())
		const current = manager ? manager.getCurrent() : null
		const inPager = Boolean(current?.closest?.('[data-pagination-root]'))
		const inCarousel = Boolean(current?.closest?.('[data-slide-root]'))
		const trapped = layer === 'modal' || layer === 'settings'
		let shoulderLabel = 'LB/RB 切换区域'
		if (inPager)
			shoulderLabel = 'LB/RB 翻页'
		else if (inCarousel)
			shoulderLabel = 'LB/RB 切换幻灯'
		else if (trapped)
			// 弹层打开时 LB/RB 被限制在最上层：那里只剩 overlay 一个区域，
			// 提示条照实说「无可切换」，不要显示一个按了没反应的动作
			shoulderLabel = 'LB/RB 无可切换'

		const labels = {
			confirm: 'A 确认',
			back: backLabel(layer),
			shoulder: shoulderLabel,
			stick: layer === 'modal' ? '右摇杆 滚动弹层' : '右摇杆 滚动',
		}
		for (const span of hintsEl.querySelectorAll('[data-big-picture-hint]'))
			span.textContent = labels[span.dataset.bigPictureHint] ?? ''
	}

	/* ── 焦点区域 ──────────────────────────────────────────────── */

	/**
	 * 目标是否「够得着」。
	 *
	 * 刻意**不比**焦点管理器严格：这里只用来决定「要不要把一个区域列进循环 / 按钮要不要显示」，
	 * 判松一点的最坏后果是循环到它时 `setRegion()` 静默不动焦点（焦点管理器自己会兜底），
	 * 判严一点则会让可用的区域凭空消失。真正的可见性判定只有焦点管理器说了算。
	 */
	function isReachable(element) {
		if (!element.isConnected)
			return false
		if (element.closest('[hidden],[inert],[aria-hidden="true"]'))
			return false
		return element.getClientRects().length > 0
	}

	/** 当前焦点目标所属的区域名 */
	function currentRegion() {
		const current = manager ? manager.getCurrent() : null
		const host = current?.closest?.(`[${REGION_ATTRIBUTE}]`)
		const value = host?.getAttribute?.(REGION_ATTRIBUTE)
		return FOCUS_REGIONS.includes(value) ? value : null
	}

	/**
	 * 列出「这一区真的有可选目标」的区域宿主。
	 *
	 * 模态打开时只认最上层弹层里的宿主：规格要求弹层打开后背景不可达，
	 * 而不这么做的话 `move()` 会沿 `main` 继续走，把焦点从弹窗里拽出去。
	 */
	function regionHosts() {
		const top = getModalStack().at(-1)
		const modalRoot = top ? document.querySelector(`[data-modal="${CSS.escape(top.key)}"]`) : null
		const hosts = []
		const seen = new Set()
		for (const node of document.querySelectorAll(FOCUS_SELECTOR)) {
			if (!isReachable(node))
				continue
			const host = node.closest(`[${REGION_ATTRIBUTE}]`)
			if (!host || seen.has(host))
				continue
			if (!FOCUS_REGIONS.includes(host.getAttribute(REGION_ATTRIBUTE)))
				continue
			if (modalRoot && !modalRoot.contains(host))
				continue
			seen.add(host)
			hosts.push(host)
		}
		return hosts.sort((a, b) => {
			const index = host => FOCUS_REGIONS.indexOf(host.getAttribute(REGION_ATTRIBUTE))
			return index(a) - index(b)
		})
	}

	function cycleRegion(delta) {
		if (!manager)
			return
		const hosts = regionHosts()
		if (hosts.length === 0)
			return
		const current = currentRegion()
		const index = hosts.findIndex(host => host.getAttribute(REGION_ATTRIBUTE) === current)
		// 当前区域不在这批宿主里（刚进模式、或焦点落在区域外）：
		// 正向从头开始、反向从末尾开始，而不是算出 `-1 + delta` 那个下标
		const next = index < 0
			? hosts[delta > 0 ? 0 : hosts.length - 1]
			: hosts[(index + delta + hosts.length) % hosts.length]
		manager.setRegion(next.getAttribute(REGION_ATTRIBUTE))
		manager.refresh()
		renderHints()
	}

	/**
	 * 把最上层弹层标成 `overlay` 区域，并把 Shell 整个从可达集合里摘掉。
	 *
	 * 标记的归属写在状态里而不是「标了就不管」：同一块 DOM 会被反复复用，
	 * 漏摘一次之后，即使弹层关掉那一区仍会留在背景里被循环到。
	 *
	 * 摘掉 Shell 的必要性：方向移动是**按区域名**过滤的，而 Shell 顶栏与弹层
	 * 同为 `overlay`。只标不摘的话，弹层里的焦点按「下」会一路走到 Shell 顶栏上。
	 * `inert` 是焦点管理器认的可见性属性（它逐个祖先查 `inert` / `aria-hidden`），
	 * 顺带也挡住鼠标点穿；`aria-hidden` 是给不支持 `inert` 的老浏览器兜的同一道闸。
	 */
	function syncModalRegion() {
		const top = getModalStack().at(-1)
		const root = top ? document.querySelector(`[data-modal="${CSS.escape(top.key)}"]`) : null
		if (root === markedModalRoot)
			return
		if (markedModalRoot)
			markedModalRoot.removeAttribute(REGION_ATTRIBUTE)
		markedModalRoot = root
		if (root && !root.hasAttribute(REGION_ATTRIBUTE))
			root.setAttribute(REGION_ATTRIBUTE, 'overlay')
		setShellInert(Boolean(root))
		manager?.refresh()
	}

	/** 弹层打开时把 Shell 标成不可达（两个属性各挡一半，缺一不可） */
	function setShellInert(trapped) {
		if (!shellEl)
			return
		shellEl.toggleAttribute('inert', trapped)
		shellEl.toggleAttribute('aria-hidden', trapped)
	}

	/* ── 设置面板 ──────────────────────────────────────────────── */

	function openSettings() {
		if (settingsState !== 'closed')
			return
		settingsState = 'open'
		settingsReturnTarget = document.activeElement instanceof HTMLElement ? document.activeElement : null
		toggle(query('[data-big-picture-settings]'), true)
		const checkbox = query('[data-big-picture-auto-entry]')
		if (checkbox)
			checkbox.checked = readAutoEntryEnabled(localStore())
		manager?.refresh()
		renderHints()
	}

	/**
	 * 设置面板收起后要等多久才把 `settings` 落回 `'closed'`。
	 *
	 * 纯逻辑已搬到 `src/lib/big-picture/settings-timing.ts`——那里才有
	 * 「从 CSS 读、绝不写死」的完整理由，以及 reduced-motion 不得归零这条
	 * `transition-duration` 的注意事项。本函数只保留 DOM 读取那一步。
	 */
	function settingsCloseDelay() {
		const panel = query('[data-big-picture-settings]')
		if (!panel)
			return MODAL_DEFAULT_DURATION
		const declared = getComputedStyle(panel).transitionDuration
		const parsed = longestCssDuration(declared)
		return parsed > 0 ? parsed : MODAL_DEFAULT_DURATION
	}

	function closeSettings() {
		if (settingsState === 'closed')
			return
		// 上一轮还在收起时（双击 Menu / A 连按返回）先把它收干净，否则两个收尾函数并存。
		// **顺序要紧**：收尾函数会把形态落回 `'closed'`，所以它必须跑在置 `'closing'` 之前，
		// 否则这一轮刚置上的「吞掉 B」会被上一个收尾函数当场抹掉
		settingsFinish?.()
		// 这段时间 resolveBackLayer() 会吞掉 B，
		// 否则第二次 B 会穿透到抽屉或页面返回把用户送走
		settingsState = 'closing'
		const panel = query('[data-big-picture-settings]')
		// 退场真的播了动画时以 `transitionend` 为准（CSS 说了算），
		// 定时器只当它不来时的兜底；两条路径都汇聚到同一个收尾函数
		const finish = () => {
			if (settingsTimer) {
				clearTimeout(settingsTimer)
				settingsTimer = 0
			}
			panel?.removeEventListener('transitionend', onTransitionEnd)
			if (settingsFinish === finish)
				settingsFinish = null
			settingsState = 'closed'
			toggle(panel, false)
			const target = settingsReturnTarget
			settingsReturnTarget = null
			// 规格：「关闭后回到触发目标」。只在模式里归还：
			// 普通模式下这个面板是鼠标点的，焦点本来就在触发按钮上
			if (active && target?.isConnected)
				target.focus({ preventScroll: true })
			manager?.refresh()
			renderHints()
		}
		/*
		 * 只认**面板自己**的 transitionend。
		 * `transitionend` 会冒泡，面板里任何一个子元素（复选框、返回按钮……
		 * Task 6 之后还有更多）播它自己的过渡，都会在面板还没收起时把这次关闭提前收尾——
		 * 于是「吞掉 B」的窗口在动画播到一半时就没了。
		 * 不按 `propertyName` 过滤：Task 6 会动哪几个属性还不定，
		 * 按属性名过滤等于让下一个人必须回来改这里；而「面板自己任一属性过渡结束」
		 * 正好就是「面板收起完了」这件事本身。
		 */
		function onTransitionEnd(event) {
			if (event.target !== panel)
				return
			finish()
		}
		settingsFinish = finish
		panel?.addEventListener('transitionend', onTransitionEnd)
		settingsTimer = setTimeout(finish, settingsCloseDelay())
	}

	function toggleSettings() {
		if (settingsState === 'closed')
			openSettings()
		else
			closeSettings()
	}

	/* ── 动作派发 ──────────────────────────────────────────────── */

	/** `<select>` / `<input type=range>`：A 只聚焦，改值交给方向键 */
	function isValueControl(element) {
		if (!element)
			return false
		if (element.localName === 'select')
			return true
		return element.localName === 'input' && (element.getAttribute('type') ?? '').toLowerCase() === 'range'
	}

	/**
	 * 在控件内用方向键改值，并派发原生 `input` / `change`。
	 *
	 * 必须派发事件而不是只改 `value`：站点的排序、字号、筛选控件都是自己监听
	 * 这两个事件的，只改值等于「滑块动了但页面没反应」。
	 */
	function adjustValue(element, direction) {
		const step = direction === 'up' || direction === 'right' ? 1 : -1
		if (element.localName === 'select') {
			const next = Math.min(element.options.length - 1, Math.max(0, element.selectedIndex + step))
			if (next === element.selectedIndex)
				return
			element.selectedIndex = next
		}
		else {
			const raw = Number.parseFloat(element.step || '1')
			const delta = (Number.isFinite(raw) && raw !== 0 ? raw : 1) * step
			const min = element.min === '' ? -Infinity : Number.parseFloat(element.min)
			const max = element.max === '' ? Infinity : Number.parseFloat(element.max)
			const next = Math.min(max, Math.max(min, Number.parseFloat(element.value || '0') + delta))
			if (next === Number.parseFloat(element.value))
				return
			element.value = String(next)
		}
		element.dispatchEvent(new Event('input', { bubbles: true }))
		element.dispatchEvent(new Event('change', { bubbles: true }))
	}

	function activate() {
		const current = manager?.getCurrent()
		if (!current) {
			manager?.focusInitial()
			return
		}
		// 选中原生下拉会在系统层弹出选单，而那一层 B 关不掉；
		// 规格给 A 的语义本来就是「在控件内用方向键改值」，所以只聚焦
		if (isValueControl(current)) {
			current.focus({ preventScroll: true })
			renderHints()
			return
		}
		// 其余走原生 click()，复用组件已有事件（含外链的 UtilLink 策略）
		manager.activate()
	}

	/**
	 * 返回目标转成焦点 key 写进会话，再导航过去。
	 *
	 * key 必须在导航**之前**写：落地页读它来恢复焦点，而落地页是下一次文档求值，
	 * 此时的模块状态早就没了。
	 */
	function goTo(path, key) {
		writeRestoreFocusKey(sessionStore(), key ?? '')
		location.assign(path)
	}

	/**
	 * 下拉的触发目标。B 关掉下拉后焦点要还给它（规格：「关闭后回到触发目标」）。
	 *
	 * `Dropdown.astro` 的 `[data-dropdown-anchor]` 只是一个容器，可聚焦的是它里面
	 * 调用方塞的按钮/链接；找不到就退到容器本身（它可能带 `tabindex`）。
	 */
	function dropdownTriggerOf(root) {
		const anchor = root?.querySelector('[data-dropdown-anchor]')
		if (!anchor)
			return null
		const focusable = anchor.querySelector('a[href],button,[tabindex]')
		return focusable instanceof HTMLElement ? focusable : (anchor instanceof HTMLElement ? anchor : null)
	}

	function goBack() {
		const layer = resolveBackLayer(backSnapshot())
		if (layer === null)
			return

		if (layer === 'settings') {
			closeSettings()
			return
		}
		if (layer === 'modal') {
			const top = getModalStack().at(-1)
			// closeModal 自己负责归还焦点给触发元素（entry.returnFocus）
			if (top)
				closeModal(top.id)
			return
		}
		if (layer === 'dropdown') {
			const root = openDropdownRoot()
			// 先记住触发目标再藏面板：藏完之后焦点所在的项变成不可聚焦，
			// 焦点会掉回 `<body>`，用户就不知道自己刚才操作的是哪个下拉了
			const trigger = dropdownTriggerOf(root)
			// Dropdown.astro 的开合状态只落在 DOM 上（它自己的注释这么写），
			// 而它的 open/close 是模块私有函数；这两行就是那份表示法的复刻
			const panel = root?.querySelector('[data-dropdown-panel]')
			if (panel)
				panel.hidden = true
			root?.removeAttribute('data-open')
			if (active && trigger?.isConnected)
				trigger.focus({ preventScroll: true })
			manager?.refresh()
			renderHints()
			return
		}
		if (layer === 'drawer') {
			closeLayout()
			return
		}

		const path = currentPath()
		const action = resolvePageReturn({
			page: pageType,
			currentPath: path,
			source: consumeNavigationSource(sessionStore(), path),
		})
		if (!action)
			return
		if (action.kind === 'exit') {
			exitBigPicture('manual')
			return
		}
		goTo(action.path, action.kind === 'source' ? action.key : '')
	}

	/** 首页精选轮播：切上一张 / 下一张，并让焦点跟着走 */
	function stepCarousel(slideRoot, delta) {
		const items = [...slideRoot.querySelectorAll('[data-slide-index]')]
		const current = manager?.getCurrent()
		const index = current ? items.indexOf(current) : -1
		const control = slideRoot.parentElement?.querySelector(delta < 0 ? '[data-slide-prev]' : '[data-slide-next]')
			?? document.querySelector(delta < 0 ? '[data-slide-prev]' : '[data-slide-next]')
		control?.click()
		if (index < 0)
			return
		const next = items[(index + delta + items.length * 2) % items.length]
		manager?.refresh()
		next?.focus({ preventScroll: true })
	}

	/**
	 * 肩键：默认循环区域，**只有焦点已经在分页控件里**时才翻页。
	 *
	 * 反过来做（页面底部存在分页就全局劫持肩键）会让用户在文章列表里按 LB 突然翻页，
	 * 规格把这条写成硬要求。轮播同理，但只在焦点位于该轮播内时才接管。
	 */
	function shoulder(delta) {
		const current = manager?.getCurrent()
		const pager = current?.closest?.('[data-pagination-root]')
		if (pager) {
			pager.querySelector(delta < 0 ? '[data-page-prev]' : '[data-page-next]')?.click()
			manager?.refresh()
			renderHints()
			return
		}
		const slide = current?.closest?.('[data-slide-root]')
		if (slide) {
			stepCarousel(slide, delta)
			renderHints()
			return
		}
		cycleRegion(delta)
	}

	/** 在候选里挑真正能滚的容器：自身可滚优先，否则第一个内容超出的子元素 */
	function scrollableWithin(root) {
		if (!root)
			return null
		if (root.scrollHeight > root.clientHeight + 1)
			return root
		for (const node of root.querySelectorAll('*')) {
			if (node.scrollHeight > node.clientHeight + 1)
				return node
		}
		return null
	}

	/**
	 * 右摇杆该滚谁：活动弹层 → 抽屉 → 页面声明的滚动容器 → `document.scrollingElement`。
	 *
	 * 规格明确「现有正文不是独立滚动盒」：文章正文滚的是页面，`article.scrollBy()`
	 * 在当前布局下什么都不动，却会让调用方以为滚过了。
	 */
	function scrollContainer() {
		const top = getModalStack().at(-1)
		const modalRoot = top ? document.querySelector(`[data-modal="${CSS.escape(top.key)}"]`) : null
		const layout = getLayoutState()
		const declared = document.querySelector('[data-gamepad-scroll]')
		const signature = `${top?.key ?? ''}|${layout}|${declared ? (declared.id || 'scroll') : ''}`
		if (signature === scrollCache.signature)
			return scrollCache.element

		let element = null
		if (modalRoot)
			element = scrollableWithin(modalRoot)
		if (!element && layout === 'sidebar')
			element = scrollableWithin(document.getElementById('blog-sidebar'))
		if (!element && layout === 'aside')
			element = scrollableWithin(document.getElementById('blog-aside'))
		if (!element)
			element = declared
		if (!element)
			element = document.scrollingElement

		scrollCache = { signature, element }
		return element
	}

	/**
	 * 右摇杆 = 电平量，位移由 `getScrollDelta()` 按帧间隔与摇杆幅度算。
	 *
	 * 这里**不再**叠一层固定像素步长：两条路径都生效会让滚动双倍速。
	 * 滚动过程中不重新聚焦、不把焦点拉回原目标——滚动与焦点导航是两条独立的轴。
	 */
	function scrollByStick(context) {
		const delta = getScrollDelta(context.axisY, context.deltaMs)
		if (!delta)
			return
		const container = scrollContainer()
		// `behavior: 'instant'` 是必须的：`:root { scroll-behavior: smooth }`
		// 会把 scrollBy 变成动画，松手后页面还在滑行
		container?.scrollBy?.({ top: delta, behavior: 'instant' })
	}

	function handleAction(action, context) {
		switch (action) {
			case 'confirm':
				activate()
				break
			case 'back':
				goBack()
				break
			case 'previous-region':
				shoulder(-1)
				break
			case 'next-region':
				shoulder(1)
				break
			case 'menu':
				toggleSettings()
				break
			case 'up':
			case 'down':
			case 'left':
			case 'right': {
				const current = manager?.getCurrent()
				// 值控件上方向键改值而不是移动焦点
				if (isValueControl(current)) {
					adjustValue(current, action)
					return
				}
				manager?.move(action)
				renderHints()
				break
			}
			case 'scroll-up':
			case 'scroll-down':
				scrollByStick(context)
				break
		}
	}

	/* ── 站内跳转来源记录 ──────────────────────────────────────── */

	/**
	 * 委托记录「从哪来」。刻意不拦任何点击：这里只是**旁路**记录，
	 * 拦下事件（preventDefault）会把站点的正常链接行为一并改掉。
	 *
	 * 放过的三类：
	 * - ctrl/meta/shift/alt 与非左键：用户明确要「在新窗口/新标签打开」，
	 *   当前文档不会离开，就没有「来源」可言；
	 * - 站外链接：来源必须是站内路径（`recordNavigationSource` 会再筛一次）；
	 * - 纯锚点与 `download` / `target`：不发生文档导航。
	 */
	function onDocumentClick(event) {
		if (event.defaultPrevented || event.button !== 0)
			return
		if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
			return
		const anchor = event.target?.closest?.('a[href]')
		if (!anchor || anchor.hasAttribute('download'))
			return
		const target = anchor.getAttribute('target')
		if (target && target !== '_self')
			return
		const href = anchor.getAttribute('href') ?? ''
		if (href.startsWith('#'))
			return
		let url
		try {
			url = new URL(anchor.href, location.href)
		}
		catch {
			return
		}
		if (url.origin !== location.origin)
			return

		const current = manager?.getCurrent()
		recordNavigationSource(sessionStore(), {
			path: normalizeRoute(currentPath()),
			// 目的地记的是链接解析出来的 pathname（不含 query / hash）：
			// 落地页比对的也是 `location.pathname`，两边必须用同一种形态，
			// 否则带 query 的站内跳转会永远对不上，退化成「没有来源」
			destination: normalizeRoute(url.pathname),
			key: current ? (readFocusTargetKey(current) ?? '') : '',
			page: pageType,
		})
	}

	/**
	 * 手动进入的兜底入口。
	 *
	 * 这是规格里「顶部或常规控制面板仍允许手动进入」那句话的落点：手动退出会置抑制，
	 * 抑制态下输入层**不轮询**，因此没有任何按键路径能把用户带回模式——只有这条不依赖
	 * 轮询的控制面板路径可以。用 `'manual'` 而不是 `'auto'`：`enterBigPicture()` 只让
	 * `manual` 绕过抑制闸（规格明确保留手动进入），传 `'auto'` 会原地被拒。
	 *
	 * 模式随之激活，`enterMode()` 里的 `controller.start()` 会重新裁决轮询并恢复循环——
	 * 所以进入之后菜单键、方向键等一切照旧可用。
	 */
	function enterManually() {
		if (active)
			return
		enterBigPicture('manual')
		// 幂等的重复一次：抑制态的循环本来是停的，`enterMode()` 已经调过一次，
		// 这里再调是为了在「模式已被别处改掉」这条边路上也保证循环真的起来
		controller?.start()
		renderStatus()
	}

	/**
	 * 设置面板里的开关。写在 `change` 上而不是 `click`：复选框的 `change`
	 * 才是「值真的变了」，而键盘（空格）与 A 键合成的 click 同样会触发它。
	 *
	 * 关掉它只改变**后续的自动进入**，不影响已经进入的模式——退出走独立按钮。
	 */
	function onPreferenceChange(event) {
		const input = event.target?.closest?.('[data-big-picture-auto-entry]')
		if (!input)
			return
		writeAutoEntryEnabled(localStore(), Boolean(input.checked))
		renderStatus()
	}

	/**
	 * Shell 自己的动作按钮。委托挂在 document 上而不是 shell 元素上：
	 * `astro:before-swap` 之后 shell 元素会被换掉，挂在元素上的监听随旧节点一起消失，
	 * 而挂在 document 上的这一份由 `teardown()` 明确摘除，重绑不会叠加。
	 *
	 * `exit` 不在这里处理：`data-big-picture-exit` 已经由 `bindBigPictureGlobals()`
	 * 委托给 `exitBigPicture('manual')`，重复处理只会多跑一遍幂等的退出。
	 */
	function onShellActionClick(event) {
		const action = event.target?.closest?.('[data-big-picture-action]')
			?.getAttribute('data-big-picture-action')
		if (!action)
			return
		if (action === 'open-nav') {
			event.preventDefault()
			toggleLayout('sidebar')
		}
		else if (action === 'open-aside') {
			event.preventDefault()
			toggleLayout('aside')
		}
		else if (action === 'open-settings') {
			event.preventDefault()
			openSettings()
		}
		else if (action === 'close-settings') {
			event.preventDefault()
			closeSettings()
		}
		else if (action === 'enter') {
			event.preventDefault()
			enterManually()
		}
	}

	/* ── 进入 / 退出 ──────────────────────────────────────────── */

	/**
	 * 把待恢复的焦点 key 兑现到真实元素上。
	 *
	 * 手法是直接 `focus()` 那个元素，而不是给焦点管理器塞一个「首选项」：
	 * `focusInitial()` 的偏好是「上次 → 首选项 → 第一项」，而页面自己也会标
	 * `data-gamepad-initial-focus`（Task 7 的事），临时属性在 DOM 顺序上未必赢得过它。
	 * 直接聚焦后焦点管理器的 `focusin` 会认领它并补上焦点类，两侧状态自动对齐。
	 * 元素已经不在（列表重排后删了）时退回页面级首选项，不硬造一个落点。
	 */
	function applyPendingFocus() {
		const key = pendingFocusKey
		pendingFocusKey = ''
		if (key)
			writeRestoreFocusKey(sessionStore(), '')
		let matched = null
		if (key) {
			for (const node of document.querySelectorAll(FOCUS_SELECTOR)) {
				if (readFocusTargetKey(node) === key) {
					matched = node
					break
				}
			}
		}
		if (!matched)
			return
		matched.focus({ preventScroll: true })
		if (document.activeElement !== matched)
			manager?.focusInitial()
	}

	function enterMode() {
		toggle(query('[data-big-picture-actions]'), true)
		toggle(query('[data-big-picture-hints]'), true)
		// 「目录」只在真的有右栏内容时出现（规格：目录（有目录时））
		toggle(
			query('[data-big-picture-action="open-aside"]'),
			Boolean(document.querySelector('[data-gamepad-region="aside"]')),
		)

		manager = createGamepadFocusManager(document.body)
		applyPendingFocus()
		if (!manager.getCurrent())
			manager.focusInitial()
		manager.refresh()

		// 抑制态下轮询门禁是关着的，模式激活后必须再裁决一次才会排下一帧
		controller?.start()
		syncModalRegion()
		renderStatus()
		renderHints()
	}

	function leaveMode() {
		// 退场定时器与 `transitionend` 监听必须在这里真的收掉：否则那个回调会在
		// 模式已经退出之后继续改 DOM、抢焦点；那个监听更糟——面板元素在页面存活期内一直
		// 都在，下一次**别的**过渡结束就会把它叫醒
		settingsFinish?.()
		settingsFinish = null
		settingsTimer = 0
		settingsState = 'closed'
		toggle(query('[data-big-picture-settings]'), false)
		manager?.destroy()
		manager = null
		if (markedModalRoot) {
			markedModalRoot.removeAttribute(REGION_ATTRIBUTE)
			markedModalRoot = null
		}
		setShellInert(false)
		drawerReturnTarget = null
		settingsReturnTarget = null
		scrollCache = { signature: '', element: null }
		toggle(query('[data-big-picture-actions]'), false)
		toggle(query('[data-big-picture-hints]'), false)
		renderStatus()
	}

	function onModeChange(mode) {
		const next = mode === 'active'
		if (next === active)
			return
		active = next
		if (active)
			enterMode()
		else
			leaveMode()
	}

	/* ── 装配与拆卸 ────────────────────────────────────────────── */

	function bindShell(shell) {
		if (shell.dataset.bpShellReady)
			return
		shell.dataset.bpShellReady = '1'
		shellEl = shell
		pageType = shell.getAttribute('data-big-picture-page') ?? 'off'

		// 'off' 页面停用本页增强，但会话意图仍由 big-picture-state 保留
		if (pageType === 'off') {
			renderStatus()
			return
		}

		pendingFocusKey = readRestoreFocusKey(sessionStore())

		controller = createGamepadController({
			onConnection: (status) => {
				device = status
				if (status !== 'none')
					everConnected = true
				renderStatus()
			},
			onDisconnection: () => {
				device = 'none'
				// 断开不改变模式（规格），提示条改文案即可
				renderStatus()
			},
			onEntryIntent: () => {
				if (!readAutoEntryEnabled(localStore())) {
					// 用户关掉了「首次按键自动进入」：提示改走 Menu 键，
					// 而不是硬闯进去——设置面板必须尊重用户的选择
					renderStatus()
					return
				}
				enterBigPicture('auto')
			},
			onAction: handleAction,
		})

		disposers.push(subscribeBigPicture(onModeChange))
		disposers.push(subscribeLayout((state) => {
			if (state !== 'none') {
				// 记住触发元素，关闭后归还焦点（closeLayout() 自己不做这件事）
				if (!drawerReturnTarget)
					drawerReturnTarget = document.activeElement instanceof HTMLElement ? document.activeElement : null
			}
			else if (active && drawerReturnTarget) {
				const target = drawerReturnTarget
				drawerReturnTarget = null
				if (target.isConnected)
					target.focus({ preventScroll: true })
			}
			manager?.refresh()
			renderHints()
		}))
		disposers.push(subscribeModals(() => {
			syncModalRegion()
			// 弹层开合会改变滚动容器与层级，缓存必须作废
			scrollCache = { signature: '', element: null }
			if (active)
				manager?.refresh()
			renderHints()
		}))

		document.addEventListener('click', onDocumentClick)
		document.addEventListener('click', onShellActionClick)
		document.addEventListener('change', onPreferenceChange)
		document.addEventListener('focusin', renderHints)

		controller.start()
		renderStatus()
	}

	/**
	 * 拆卸页面控制器。**不动模式意图**——规格明写 `astro:before-swap` 只销毁页面控制器，
	 * 意图由会话保留，换页后 `astro:page-load` 再恢复。
	 *
	 * 幂等由「所有句柄置空」保证：重复调用不会重复解绑，也不会留下第二条 rAF 循环
	 * （控制器自己的 `stop()` 是幂等的，这里保证的是我们这层不再持有它）。
	 */
	function teardown() {
		for (const dispose of disposers)
			dispose()
		disposers = []
		// 面板元素会活过 swap（ClientRouter），那个 `transitionend` 监听必须摘掉，
		// 否则它会在新页面的某次过渡结束时被叫醒并改这边的状态
		settingsFinish?.()
		settingsFinish = null
		settingsTimer = 0
		document.removeEventListener('click', onDocumentClick)
		document.removeEventListener('click', onShellActionClick)
		document.removeEventListener('change', onPreferenceChange)
		document.removeEventListener('focusin', renderHints)
		manager?.destroy()
		manager = null
		controller?.stop()
		controller = null
		if (markedModalRoot) {
			markedModalRoot.removeAttribute(REGION_ATTRIBUTE)
			markedModalRoot = null
		}
		setShellInert(false)
		shellEl = null
		active = false
		settingsState = 'closed'
		device = 'none'
		everConnected = false
		pendingFocusKey = ''
		pageType = 'off'
		drawerReturnTarget = null
		settingsReturnTarget = null
		scrollCache = { signature: '', element: null }
	}

	function initShell() {
		// 同一个文档里只接一次。`astro:page-load` 与 `DOMContentLoaded` 都可能先到，
		// 谁后到谁被这道守卫挡下，而不是挂出第二套监听与第二条 rAF 循环
		if (controller)
			return
		const shell = document.querySelector('[data-big-picture-shell]')
		if (shell)
			bindShell(shell)
	}

	/*
	 * 三个 `bind*Globals()` 都是幂等的：谁先初始化都只挂一份委托。
	 * 放在 `initShell()` **之前**是有意的——`bindBigPictureGlobals()` 会立刻按会话
	 * 意图恢复模式，同时把它的 `astro:page-load` 监听排在我们的前面；
	 * 反过来的话，首次进入要等它自己那次恢复才发生，顺序就成了隐式依赖。
	 */
	bindBigPictureGlobals()
	bindLayoutGlobals()
	bindModalGlobals()

	if (document.readyState === 'loading')
		document.addEventListener('DOMContentLoaded', initShell)
	else
		initShell()
	document.addEventListener('astro:page-load', initShell)
	document.addEventListener('astro:before-swap', teardown)
</script>
