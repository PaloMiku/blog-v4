---
/**
 * Toc 组件（Astro 版），对应 `app/components/widget/Toc.vue`。
 *
 * ## 目录数据来源
 * Nuxt 侧 `useArticle().toc` 来自 `@nuxt/content` 的 `body.toc`，是一棵
 * `TocLink[]` 树。Astro 侧对应物是 `render(entry)` 返回的 `headings`
 * （`MarkdownHeading[]`：`{ depth, slug, text }`），是**扁平**的。
 * 故本组件接收 `headings`，在构建期按 `depth` 还原成嵌套树
 * （与 @nuxt/content 内部构树逻辑一致：depth 变深就压栈，否则回退到上一层）。
 *
 * 布局层接法（不在本组件范围内）：
 *   const { Content, headings } = await render(entry)
 *   <Toc headings={headings} />
 *
 * ## 与 Nuxt 版的差异
 * 1. `createReusableTemplate` 递归模板 → 构建期递归函数（纯渲染，输出完全一致）。
 * 2. `useToc` composable（`app/composables/useToc.ts`）拆成两半：
 *    - `tocOffsets` 用来算 `minHeight`，等价于**标题总数**，
 *      构建期直接从 `headings.length` 得到，无需测量 DOM；
 *    - `activeHeadingId` 滚动高亮 + 把高亮项滚进可视区，需要真实
 *      `getBoundingClientRect`，留在客户端脚本里（下方 `<script>`）。
 *      倒序查找（`findLast` 的替代）、`scroll-margin-top` 读取、
 *      `scrollTo` 定位等逻辑逐行照搬。
 * 3. `useTemplateRef('toc')` + `defineExpose({ body })` 换成
 *    `root.querySelector('.widget-body')`——Nuxt 侧 `scrollableEl` 取的
 *    正是 BlogWidget 暴露出来的 `.widget-body`（`shrink` 让它可滚动）。
 *
 * ## 注释区锚点
 * 原模板固定指向 `#twikoo`（评论系统容器），该容器属 Phase 4 的评论区，
 * 此处保留锚点，行为与原来一致（目标不存在时浏览器不跳转）。
 */
import BlogWidget from '../blog/BlogWidget.astro'
import Icon from '../Icon.astro'

/** 与 @nuxt/content 的 MarkdownHeading 同构 */
export interface TocHeading {
	depth: number
	slug: string
	text: string
}

interface TocLink {
	id: string
	text: string
	children?: TocLink[]
}

interface Props {
	/** `render(entry)` 返回的 headings（扁平，按文档顺序） */
	headings?: TocHeading[]
	class?: string
}

const { headings = [], class: className } = Astro.props

/**
 * 扁平 headings → 嵌套 TocLink 树。
 * 规则与 @nuxt/content 一致：维护一个按 depth 索引的栈，
 * 比栈顶更深就是子级，否则回退到对应深度再挂。
 */
function buildTocTree(flat: TocHeading[]): TocLink[] {
	const root: TocLink[] = []
	const stack: TocLink[] = []

	for (const heading of flat) {
		const node: TocLink = { id: heading.slug, text: heading.text }
		// depth 从 1 开始，栈里第 i 层对应 depth === i + 1
		const level = Math.max(heading.depth, 1)
		const parent = stack[level - 2]

		if (parent) {
			(parent.children ??= []).push(node)
		}
		else {
			root.push(node)
		}

		stack[level - 1] = node
		stack.length = level
	}

	return root
}

const links = buildTocTree(headings)

/** 等价于 Nuxt 侧 `tocOffsets.length`（flattenToc 后的条目数 = 标题总数） */
const headingCount = headings.length

/**
 * 目录树 → HTML 字符串。
 *
 * ⚠️ **属性必须写在这个字符串里**：目录树是 `set:html` 注入的，
 * 这些 `<a>` / `<li>` 不经过 Astro 的模板编译，写在模板上的任何属性都到不了它们身上。
 * 反过来，`data-astro-cid` 也不会出现在这些节点上（CLAUDE.md 坑位 4）——
 * 所以样式侧靠 `:global(.toc …)`，属性同理只能写进这个字符串。
 *
 * 目录项的 `data-list-key` 用**标题 slug**：它是锚点目标，天然唯一且稳定，
 * 而标题文本可能重复（同名小节）。`toc:` 命名空间与页内其它列表不会撞。
 */
function renderToc(tree: TocLink[]): string {
	const li = tree.map((entry) => {
		const child = entry.children?.length ? renderToc(entry.children) : ''
		return `<li data-toc-id="${entry.id}"><a href="#${entry.id}" title="${escapeAttr(entry.text)}" data-list-key="toc:${escapeAttr(entry.id)}">${escapeText(entry.text)}</a>${child}</li>`
	}).join('')
	return `<ol>${li}</ol>`
}

function escapeText(s: string) {
	return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
}

function escapeAttr(s: string) {
	return escapeText(s).replace(/"/g, '&quot;')
}

/*
 * 原模板用 `createReusableTemplate` 递归渲染成真实 DOM（带 has-active / active 绑定）。
 * 这里的 active 状态只能在客户端算出来，构建期渲染不了，
 * 故改为「构建期把整棵树渲染成 HTML 字符串（set:html 输出），
 * 客户端脚本再按 data-toc-id 挂 active / has-active」。
 * 层级 <ol>/<li>/<a> 结构与原版逐层一致。
 */
const tocHtml = links.length ? renderToc(links) : ''
---

<BlogWidget title="文章目录" shrink class={className} style={{ minHeight: `clamp(4rem, ${headingCount}rem, 20rem)` }}>
	<Fragment slot="action">
		<!-- use <a> for anchor -->
		{/*
			这两个是 aside 区里的固定动作。Widget 的 action 槽是**具名 slot**，
			节点由本组件渲染（不是 `set:html` 字符串），所以属性写在模板上即可。
		*/}
		<a href="#main-content" aria-label="返回开头" data-list-key="toc:action:top">
			<Icon name="tabler:arrow-bar-to-up" />
		</a>

		<a href="#twikoo" aria-label="评论区" data-list-key="toc:action:comments">
			<Icon name="tabler:message-dots" />
		</a>
	</Fragment>

	{tocHtml
		? <div class="toc" data-toc set:html={tocHtml} />
		: <p class="no-toc">暂无目录信息</p>}
</BlogWidget>

<script>
	function initToc(root) {
		if (!(root instanceof HTMLElement) || root.dataset.tocReady)
			return
		root.dataset.tocReady = '1'

		const items = [...root.querySelectorAll('[data-toc-id]')]

		/** 目录项 → 正文标题元素。取不到对应标题的项仍保留（与原实现一致，它只跳过 undefined 偏移） */
		const entries = items.map(li => ({
			li,
			id: li.dataset.tocId,
			el: li.dataset.tocId ? document.getElementById(li.dataset.tocId) : null,
		}))

		// Nuxt 侧是 `useTemplateRef('toc').body`，即 BlogWidget 暴露的 .widget-body
		const scrollableEl = root.closest('.blog-widget')?.querySelector('.widget-body')

		/*
		 * 判定线：吸顶头下方，标题 top 越过它就认为「该章节开始」。
		 *
		 * 为什么是硬编码 64 而不是像旧代码那样读 `scroll-margin-top`：那行代码读的是
		 * `document.documentElement` 上的 `scroll-margin-top`，而**全站从未设置过这个属性**
		 * （src/、public/ 与产物 CSS 里都搜不到），所以它一直回落到 64。
		 * 真正生效的吸顶量是 `main.css` 的 `scroll-padding: 2rem`——那是给浏览器的
		 * 锚点滚动消费的，与这条判定线无关。保留 64 = 保留原有行为。
		 */
		const LINE_Y = 64

		/**
		 * 标题 id → 文档内绝对 top；倒序排列，便于从后往前找命中项。
		 *
		 * ⚠️ **这是本组件唯一需要读布局的地方**，只在「内容几何可能变了」时调用，
		 * 不参与滚动逐帧路径：滚动只做 `scrollY` 与缓存值的算术比较。
		 */
		let offsets = []
		function refreshOffsets() {
			offsets = entries
				.map(({ id, el }) => ({
					id,
					offsetTop: el ? el.getBoundingClientRect().top + (window.scrollY ?? 0) : undefined,
				}))
				.reverse()
		}

		/**
		 * 当前章节 = **最后一个越过了判定线的标题**。
		 *
		 * 用「读当前位置比大小」而不是 `IntersectionObserver`：后者只在**相交状态变化**时投递条目，
		 * 而快速滚动（一个滚轮刻度常超过 100px、End 键、拖拽滚动条）可以让标题在一帧内
		 * 整段跨过任何固定高度的观察区而不产生条目，高亮就会滞后。位置比较天然免疫跳跃。
		 */
		function getActiveHeading() {
			const scrollOffset = window.scrollY + LINE_Y
			return offsets.find(item => item.offsetTop !== undefined && item.offsetTop <= scrollOffset)?.id
		}

		function scrollToActiveTocItem(activeId) {
			const active = activeId ? root.querySelector(`a[href="#${activeId}"]`) : null
			if (scrollableEl && active) {
				scrollableEl.scrollTo({
					top: active.offsetTop - scrollableEl.clientHeight / 4,
					behavior: 'smooth',
				})
			}
		}

		let activeId
		function setActive(id) {
			activeId = id
			for (const { li, id: itemId } of entries)
				li.classList.toggle('active', itemId === id)
			/*
			 * 祖先的 `has-active` 不再由脚本维护：CSS 侧 `:has(.active)` 表达同一语义
			 * （「自身或后代里有 active」），省掉每个目录项一次的祖先链遍历。
			 */
		}

		function update() {
			const next = getActiveHeading()
			if (next === activeId)
				return
			setActive(next)
			scrollToActiveTocItem(next)
		}

		/** 重算偏移并立刻校正高亮——内容几何变化后必须与当前滚动位置重新对齐 */
		function realign() {
			refreshOffsets()
			update()
		}

		// 原版用 refThrottled(scrollY)，这里用 rAF 自己做节流
		let ticking = false
		function onScroll() {
			if (ticking)
				return
			ticking = true
			requestAnimationFrame(() => {
				ticking = false
				update()
			})
		}

		window.addEventListener('scroll', onScroll, { passive: true })

		/*
		 * 正文高度变化时重算偏移。
		 *
		 * **这是原实现真正的缺陷所在**：它在初始化时算一次 `offsets` 之后再无写入，
		 * 而 resize 监听只调用 `update()`（读的仍是那份陈旧缓存），所以注释里写的
		 * 「正文高度变化要重算 offset」从来没有实现过。后果是迟到的图片/代码块/字体
		 * 把标题推走之后，高亮会**永久**偏移——它只会在下一次页面加载时自愈。
		 *
		 * ResizeObserver 直接盯内容盒：图片撑开是高度变化，字体替换也是，两种情况都覆盖。
		 * rAF 合并是因为一张长文里可能连续触发多次。
		 */
		let realigning = false
		function onGeometryChange() {
			if (realigning)
				return
			realigning = true
			requestAnimationFrame(() => {
				realigning = false
				realign()
			})
		}

		const geoObserver = new ResizeObserver(onGeometryChange)
		// 观察正文容器：它的高度会随图片/字体到位而增长
		const contentRoot = document.getElementById('main-content') ?? document.body
		geoObserver.observe(contentRoot)

		refreshOffsets()
		setActive(getActiveHeading())
	}

	function initAll() {
		for (const root of document.querySelectorAll('[data-toc]'))
			initToc(root)
	}

	if (document.readyState === 'loading')
		document.addEventListener('DOMContentLoaded', initAll)
	else
		initAll()
	document.addEventListener('astro:page-load', initAll)
</script>

<style>
.toc {
	position: relative;

	&::before {
		content: "";
		position: absolute;
		inset: 0.3rem;
		width: 3px;
		border-radius: 1rem;
		background-color: var(--c-bg-soft);
	}
}

/*
 * 目录树是 set:html 注入的字符串，拿不到本组件的 scope 属性，
 * 故凡是面向它的后代选择器都要 :global()（陷阱 2/3）。
 * .toc 外壳本身是本组件渲染的，仍走 scoped。
 */
:global(.toc ol) {
	padding-inline-start: 0.8rem;
}

:global(.toc li) {
	opacity: 0.6;
	font-size: 0.94em;
	color: var(--c-text);
	transition: opacity 0.2s;

	&:hover {
		opacity: 0.94;
	}

	/*
	 * `:has(.active)` 是原来脚本维护的 `has-active` 类的等价物：
	 * 「自身是 active，或**其后代里有** active」——目录嵌套时父项随子项一起提亮。
	 * 交给 CSS 之后脚本不必再为每个目录项遍历一次祖先链（见 Toc 脚本处的说明）。
	 */
	&:has(.active), &.active {
		opacity: 1;
		font-size: 1em;
	}

	&.active::before {
		content: "";
		position: absolute;
		inset-inline-start: 0.3rem;
		margin: 0.2rem 0;
		padding: 0.6rem 1.5px;
		border-radius: 1rem;
		background-color: var(--c-primary);
	}

	> a {
		display: block;
		overflow: hidden;
		padding: 0.2em 0.5em;
		border-radius: 0.5em;
		white-space: nowrap;
		text-overflow: ellipsis;
		transition: all 0.2s;

		&:hover {
			background-color: var(--c-bg-soft);
		}
	}
}

.no-toc {
	padding: 1em;
	text-align: center;
	color: var(--c-text-3);
}
</style>
