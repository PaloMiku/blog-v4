---
/**
 * BlogStats 组件（Astro 版），对应 `app/components/widget/BlogStats.vue`。
 *
 * ## 数据来源（重要）
 * 原组件用 `useFetch('/api/stats')` 在客户端拉取。Astro 侧该端点已存在于
 * `src/pages/api/stats.ts` 且 `prerender = true`，产物是构建期写出的静态 JSON
 * （`/api/stats`）。**客户端 fetch 在部署后同源可达时是能工作的**
 * （GitHub Pages / EdgeOne 下 `/api/stats` 就是那个 JSON 文件），
 * 但这会让统计数字晚于首屏出现，且构建失败时静默降级。
 *
 * 采纳任务指定的方案：**由布局层把数据作为 prop 传入**。
 * 布局层调用 `src/lib/stats.ts` 的 `getStats()`，与 `/api/stats` 端点同一份实现，
 * 因此页面上的数字与公开 JSON 永远一致。首页与归档页均已注入。
 * 未传 `stats` 时显示 `--`，与原版 stats 为空时一致（仅作兜底，非预期用法）。
 *
 * ## 其他差异
 * - `timeElapse` / `formatNumber` 来自 `shared/utils/*`，Astro 侧经 `src/lib/shared.ts` 转出。
 * - `UtilDate`（`app/components/util/Date.vue`）内联在此：原版用 `NuxtTime relative`
 *   输出「几天前」并带 `title` 绝对时间；这里 `<time datetime>` 里放构建期算好的
 *   相对文案作初值，客户端脚本在每次加载时按 `datetime` 重算一次
 *   （见下方 `<script>`），保证部署后每次打开页面文案都是对的
 *   ——不做打开期间的持续轮询（用户 2026-10-06 明确不要）。
 * - `v-tip` 属 Phase 4（与 `content/Tip.astro` 一致），title 保留。
 */
import BlogWidget from '../blog/BlogWidget.astro'
import DlGroup, { type DlItem } from '../blog/DlGroup.astro'
import { appConfig } from '../../lib/app-config'
import { formatNumber, timeElapse } from '../../lib/shared'
import { formatRelative } from '../../lib/relative-time'

/** 与 `src/lib/stats.ts` 的 `BlogStats` 结构对应 */
export interface BlogStatsData {
	total: { posts: number, words: number }
	annual: Record<string | number, { posts: number, words: number }>
}

interface Props {
	/** 由布局层注入的统计数据（`getStats()` 的返回值）；不传则显示 `--` */
	stats?: BlogStatsData
	class?: string
}

const { stats, class: className } = Astro.props

const yearlyTip = Object
	.entries(stats?.annual ?? {})
	.reverse()
	.map(([year, item]) => `${year}年：${item.posts}篇，${item.words}字`)
	.join('\n') || '数据获取失败'

/*
 * 构建时间：静态站每次构建都会重新求值，等价于 Nuxt 侧
 * `runtimeConfig.public.buildTime = Temporal.Now.zonedDateTimeISO()`。
 * 可由布局层传入覆盖（例如复用某个统一的构建时间戳）。
 */
const buildTime = new Date().toISOString()

const blogStats: DlItem[] = [
	{
		label: '运营时长',
		value: timeElapse(appConfig.timeEstablished),
		tip: `博客于${appConfig.timeEstablished}上线`,
	},
	{
		label: '上次更新',
		/*
		 * 构建期算好初值，客户端脚本在每次加载时重算（见下方 `<script>`）：
		 * 纯构建期文案在部署后随时间流逝会失真（构建后第 10 天仍显示「1小时前」），
		 * 而原 Nuxt 侧 `h(UtilDate, { relative: true, tipPrefix: '构建于' })` 走的
		 * NuxtTime 是客户端组件、水合后会重算。这里不走「先渲染绝对日期再改写」的
		 * 老路——初值本身就是相对文案（只差构建到访问的间隔），不存在首屏闪动。
		 */
		value: formatRelative(buildTime),
		datetime: buildTime,
		tip: `构建于 ${buildTime}`,
	},
	{
		label: appConfig.stats.includePaths.length ? '文章字数' : '总字数',
		value: formatNumber(stats?.total?.words) || '--',
		tip: yearlyTip,
	},
]
---

<BlogWidget card title="博客统计" class={className}>
	<DlGroup size="small" items={blogStats} class="blog-stats" />
</BlogWidget>

<script>
	/*
	 * 「上次更新」的相对文案保证每次加载都是对的：SSR 初值是构建期算好的
	 * （无 JS 也正确、无闪动），脚本在加载时按 `<time datetime>` 重算一次。
	 * 只修「构建到访问的间隔」这一段失真，打开期间不轮询
	 * （相对表述以分钟为最小单位，停留几分钟内不会变档；用户明确不要实时刷新）。
	 *
	 * 单位阶梯与 `src/lib/relative-time.ts` 的 `RELATIVE_UNITS` 语义相同——
	 * 与 EmojiClock 同款的前后端各一份（Astro 的打包脚本要隔离构建期依赖，
	 * 不想把 `blogConfig` 整个拖进客户端 bundle），改任一侧必须同步另一侧。
	 * locale 不写死也不打包 config：`Base.astro` 已把 `blogConfig.language`
	 * 落在 `<html lang>` 上，从这里读。
	 */
	const RELATIVE_UNITS = [
		{ unit: 'second', seconds: 1, threshold: 60 },
		{ unit: 'minute', seconds: 60, threshold: 60 },
		{ unit: 'hour', seconds: 3600, threshold: 24 },
		{ unit: 'day', seconds: 86400, threshold: 30 },
		{ unit: 'month', seconds: 2592e3, threshold: 12 },
		{ unit: 'year', seconds: 31536e3, threshold: Infinity },
	] as const

	function refresh(el: HTMLTimeElement) {
		const ms = new Date(el.dateTime).getTime()
		if (Number.isNaN(ms))
			return
		const diffInSeconds = (ms - Date.now()) / 1e3
		const { unit, seconds } = RELATIVE_UNITS.find(({ seconds: s, threshold }) => Math.abs(diffInSeconds / s) < threshold)
			?? RELATIVE_UNITS[RELATIVE_UNITS.length - 1]!
		el.textContent = new Intl.RelativeTimeFormat(document.documentElement.lang || 'zh-CN', { numeric: 'auto' })
			.format(Math.round(diffInSeconds / seconds), unit)
	}

	function initAll() {
		for (const el of document.querySelectorAll<HTMLTimeElement>('.blog-stats dd time[datetime]'))
			refresh(el)
	}

	if (document.readyState === 'loading')
		document.addEventListener('DOMContentLoaded', initAll)
	else
		initAll()
	document.addEventListener('astro:page-load', initAll)
</script>

<style>
/*
 * DlGroup 是独立组件，带它自己的 scope；
 * .blog-stats 这个 class 由 BlogWidget/DlGroup 显式接收后落根元素上，
 * 但其内部 dd/time 由 DlGroup 渲染、不带本组件 scope，故需要 :global()。
 */
.blog-stats :global(dd time) {
	font-variant-numeric: tabular-nums;
}
</style>
