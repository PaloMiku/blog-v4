---
/**
 * Tab 组件（Astro + 原生 JS，非 Vue 岛）。
 *
 * 为什么不做成 Vue 岛：
 * 1. 交互只是「切换哪个 panel 可见」，约 20 行原生 JS 即可，引入 Vue runtime 不划算
 *    （全库 42 处使用）。
 * 2. MDX 在 Astro 侧编译为 Astro 组件，把渲染结果作为 prop 数组传给 Vue 岛
 *    属于跨框架传递，脆弱。
 *
 * API 变更（必要且有意）：
 * 原 Vue 版用 `<slot :name="` + "`tab${activeTab}`" + ` />` 即**运行时计算的动态具名 slot**，
 * slot 名从 1 开始。MDX 无法静态映射这种 slot。
 *
 * 两种候选方案都实测过：
 * - `panels={[<p>a</p>, <p>b</p>]}`（数组 prop）→ 渲染成 `[object Object]`。
 *   MDX 的 JSX 数组元素是 Astro 组件工厂函数，不是可直接渲染的对象。**不可行**。
 * - MDX 具名 slot `<div slot="tab1">…</div>` + `Astro.slots.render('tab1')` → **可行**。
 *   注意 `Astro.slots.render()` 返回 HTML 字符串，必须用 `<Fragment set:html={...} />`
 *   输出，直接放进 JSX 会被转义成 `&lt;div&gt;`。
 *
 * 因此 MDX 侧的形态是：
 *   <Tab tabs={["A", "B"]} active={2}>
 *     <div slot="tab1">…</div>
 *     <div slot="tab2">…</div>
 *   </Tab>
 * 组件在**构建期**按 `tabs.length` 静态索引 `tab1..tabN`，不存在运行时动态 slot 名。
 */
interface Props {
	/** tab 名称数组 */
	tabs: string[]
	/** 初始选中下标，从 1 开始 */
	active?: string | number
	center?: boolean
	/** 使用下拉框样式 */
	combobox?: boolean
	/** 是否显示边框 */
	border?: boolean
}

const {
	tabs,
	active = 1,
	center = false,
	combobox = false,
	border = false,
} = Astro.props

const initial = Math.min(Math.max(Number(active) || 1, 1), tabs.length)
const current = tabs[initial - 1] ?? ''

// 构建期把具名 slot 渲染成 HTML 字符串，交互时只切换 hidden，不重新渲染内容
const panelHtml = tabs.map((_, i) => Astro.slots.render(`tab${i + 1}`))
---

{combobox
	? (
		<div class="combobox-wrapper" class:list={{ 'has-border': border }}>
			<div class="combobox-container" data-tab-root>
				<button class="combobox-trigger" type="button" aria-expanded="false" data-combobox-trigger>
					<span class="combobox-label" data-combobox-label>{current}</span>
					<svg class="combobox-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<polyline points="6 9 12 15 18 9" />
					</svg>
				</button>

				<div class="combobox-dropdown" data-combobox-dropdown hidden>
					<div class="combobox-list">
						{tabs.map((tab, index) => (
							<button
								class="combobox-item"
								class:list={{ active: index + 1 === initial }}
								type="button"
								data-tab-select={index + 1}
							>
								<span>{tab}</span>
								{index + 1 === initial && (
									<svg class="combobox-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<polyline points="20 6 9 17 4 12" />
									</svg>
								)}
							</button>
						))}
					</div>
				</div>
			</div>

			<div class="tab-content">
				{panelHtml.map((html, index) => (
					<div class="tab-panel" data-tab-panel={index + 1} hidden={index + 1 !== initial} set:html={html} />
				))}
			</div>
		</div>
	)
	: (
		<div class:list={{ center, 'has-border': border }} data-tab-root>
			<div class="tabs" role="tablist">
				{tabs.map((tab, index) => (
					<button
						class="tabs-button"
						class:list={{ active: index + 1 === initial }}
						type="button"
						role="tab"
						aria-selected={index + 1 === initial ? 'true' : 'false'}
						data-tab-select={index + 1}
					>
						{tab}
					</button>
				))}
			</div>
			<div class="tab-content">
				{panelHtml.map((html, index) => (
					<div class="tab-panel" data-tab-panel={index + 1} hidden={index + 1 !== initial} set:html={html} />
				))}
			</div>
		</div>
	)}

<script>
	// 原生脚本会被 Astro 去重合并，故用 data 属性定位各个 Tab 实例
	function initTab(root) {
		if (!(root instanceof HTMLElement) || root.dataset.tabReady)
			return
		root.dataset.tabReady = '1'

		const panels = [...root.querySelectorAll('[data-tab-panel]')]

		function select(index) {
			for (const btn of root.querySelectorAll('[data-tab-select]')) {
				const on = Number(btn.dataset.tabSelect) === index
				btn.classList.toggle('active', on)
				if (btn.getAttribute('role') === 'tab')
					btn.setAttribute('aria-selected', on ? 'true' : 'false')
			}
			panels.forEach(p => p.hidden = Number(p.dataset.tabPanel) !== index)
		}

		root.addEventListener('click', (e) => {
			const btn = e.target.closest?.('[data-tab-select]')
			if (!btn || !root.contains(btn))
				return
			const index = Number(btn.dataset.tabSelect)
			select(index)

			// combobox 模式下同步下拉框标签与勾选态
			const label = root.querySelector('[data-combobox-label]')
			const span = btn.querySelector('span')
			if (label && span)
				label.textContent = span.textContent
			for (const item of root.querySelectorAll('.combobox-item')) {
				const on = item === btn
				item.classList.toggle('active', on)
				const check = item.querySelector('.combobox-check')
				check?.remove()
				if (on) {
					const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg')
					svg.setAttribute('class', 'combobox-check')
					svg.setAttribute('viewBox', '0 0 24 24')
					svg.setAttribute('fill', 'none')
					svg.setAttribute('stroke', 'currentColor')
					svg.setAttribute('stroke-width', '2')
					const poly = document.createElementNS('http://www.w3.org/2000/svg', 'polyline')
					poly.setAttribute('points', '20 6 9 17 4 12')
					svg.appendChild(poly)
					item.appendChild(svg)
				}
			}
		})

		const trigger = root.querySelector('[data-combobox-trigger]')
		const dropdown = root.querySelector('[data-combobox-dropdown]')
		if (trigger && dropdown) {
			trigger.addEventListener('click', (e) => {
				e.stopPropagation()
				const open = trigger.getAttribute('aria-expanded') === 'true'
				trigger.setAttribute('aria-expanded', open ? 'false' : 'true')
				dropdown.hidden = open
			})
			document.addEventListener('click', () => {
				trigger.setAttribute('aria-expanded', 'false')
				dropdown.hidden = true
			})
		}
	}

	function initAll() {
		for (const root of document.querySelectorAll('[data-tab-root]'))
			initTab(root)
	}

	if (document.readyState === 'loading')
		document.addEventListener('DOMContentLoaded', initAll)
	else
		initAll()
	document.addEventListener('astro:page-load', initAll)
</script>

<style>
.float-in-leave-active {
	position: revert !important;
}

.center {
	width: fit-content;
	max-width: 100%;
	margin-inline: auto;
}

/* ===== 边框包装器样式 ===== */
.has-border {
	padding: 1.2em;
	border: 1px solid var(--c-border);
	border-radius: 0.8em;
	background-color: var(--ld-bg-card);
}

/* ===== 原始 Tabs 样式 ===== */
.tabs {
	display: flex;
	flex-wrap: wrap;
	justify-content: center;
	gap: 0.5em;
	position: relative;
	width: fit-content;
	margin: 0 auto;
	font-size: 0.9em;
	line-height: 1.4;

	button {
		position: relative;
		margin-bottom: 0.5em;
		padding: 0.3em 0.5em;
		border-radius: 0.4em;
		color: var(--c-text-2);
		transition: all 0.2s;

		&:hover {
			background-color: var(--c-bg-soft);
			color: var(--c-text);
		}

		&::before, &::after {
			display: block;
			position: absolute;
			inset-inline: 0.8em;
			bottom: -0.5em;
			height: 2px;
			border-radius: 1em;
			pointer-events: none;
		}

		&::after {
			content: "";
			inset-inline: -0.8em;
			background-color: var(--c-border);
		}

		&.active {
			box-shadow: 0 1px 0.5em var(--ld-shadow);
			background-color: var(--ld-bg-card);
			color: var(--c-text);

			&::before {
				content: "";
				background-color: var(--c-primary);
				z-index: 1;
			}
		}
	}
}

/* ===== Combobox 下拉框样式 ===== */
.combobox-wrapper {
	width: 100%;
}

.combobox-container {
	position: relative;
	width: fit-content;
	max-width: 100%;
	padding: 0;
}

.combobox-trigger {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 0.5em;
	min-width: 140px;
	max-width: 100%;
	padding: 0.4em 0.7em;
	border: 1px solid var(--c-border);
	border-radius: 0.5em;
	box-shadow: 0 1px 2px rgb(0 0 0 / 5%);
	background-color: var(--ld-bg-card);
	font-size: 0.85em;
	font-weight: 500;
	color: var(--c-text);
	transition: all 0.2s ease;
	cursor: pointer;

	.dark & {
		border-color: hsl(var(--hue-theme) 10% 40%);
	}

	&:hover {
		border-color: var(--c-primary);
		box-shadow: 0 2px 8px rgb(0 0 0 / 10%);
		background-color: var(--c-bg-soft);
	}

	&:focus {
		box-shadow: 0 0 0 2px var(--c-bg), 0 0 0 4px var(--c-primary);
		outline: none;
	}

	&[aria-expanded="true"] {
		border-color: var(--c-primary);
		background-color: var(--c-bg-soft);
	}
}

.combobox-label {
	flex: 1;
	overflow: hidden;
	white-space: nowrap;
	text-align: left;
	text-overflow: ellipsis;
}

.combobox-icon {
	flex-shrink: 0;
	opacity: 0.7;
	width: 1em;
	height: 1em;
	color: var(--c-text-2);
	transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);

	&.open {
		opacity: 1;
		color: var(--c-primary);
		transform: rotate(180deg);
	}
}

.combobox-dropdown {
	position: absolute;
	overflow: hidden;
	top: calc(100% + 0.4em);
	right: 0;
	left: 0;
	min-width: 100%;
	max-width: 100%;
	border: 1px solid var(--c-border);
	border-radius: 0.6em;
	box-shadow: 0 8px 20px rgb(0 0 0 / 12%);
	background-color: var(--ld-bg-card);
	z-index: 10;
}

.combobox-search {
	display: flex;
	align-items: center;
	gap: 0.4em;
	padding: 0.4em 0.5em;
	border-bottom: 1px solid var(--c-border);
	background-color: var(--c-bg-soft);
}

.search-icon {
	flex-shrink: 0;
	opacity: 0.5;
	width: 0.9em;
	height: 0.9em;
	color: var(--c-text-2);
}

/*
 * `:global()` 是必须的：这条规则照抄自 Nuxt 侧 Tab.vue，用的是 `:deep()` 语义
 * （穿透组件边界去样式化 SearchModal 内部的 input）。Astro 的 scoped 没有这个
 * 能力——那个 `<input class="search-input">` 由 SearchModal 渲染、带的是
 * **它的** cid，不带 Tab 的，于是整条规则永不匹配。
 * 该 class 全站仅此一个元素，改 global 无扩散风险。
 * 见 docs/astro-phase1-findings.md §50，scripts/audit-dead-scope.mjs 可复现。
 */
:global(.search-input) {
	flex: 1;
	min-width: 0;
	padding: 0.15em 0;
	border: none;
	outline: none;
	background-color: transparent;
	font-size: 0.85em;
	color: var(--c-text);

	&::placeholder {
		color: var(--c-text-3);
	}

	&:focus {
		color: var(--c-text);
	}
}

.combobox-list {
	display: flex;
	flex-direction: column;
	overflow-y: auto;
	max-height: 220px;

	/* 自定义滚动条样式 */
	&::-webkit-scrollbar {
		width: 6px;
	}

	&::-webkit-scrollbar-track {
		background: transparent;
	}

	&::-webkit-scrollbar-thumb {
		border-radius: 3px;
		background: var(--c-border);

		&:hover {
			background: var(--c-text-2);
		}
	}
}

.combobox-item {
	display: flex;
	align-items: center;
	justify-content: space-between;
	width: 100%;
	padding: 0.4em 0.6em;
	border: none;
	background-color: transparent;
	font-size: 0.85em;
	text-align: left;
	color: var(--c-text-2);
	transition: all 0.12s ease;
	cursor: pointer;

	&:hover {
		padding-left: 0.8em;
		background-color: var(--c-bg-soft);
		color: var(--c-text);
	}

	&.active {
		background-color: var(--c-primary-soft);
		font-weight: 600;
		color: var(--c-primary);
	}

	&:focus {
		outline: none;
		background-color: var(--c-bg-soft);
	}
}

.combobox-check {
	flex-shrink: 0;
	width: 1em;
	height: 1em;
	margin-left: 0.3em;
	color: var(--c-primary);
	animation: checkmark 0.3s ease;
}

.combobox-empty {
	padding: 1.5em 0.7em;
	font-size: 0.9em;
	text-align: center;
	color: var(--c-text-2);
}

.tab-content {
	margin-top: 0.5em;
	padding: 0.5em 0;
}

/* ===== Dropdown 动画 ===== */
.dropdown-enter-active,
.dropdown-leave-active {
	transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.dropdown-enter-from {
	opacity: 0;
	transform: translateY(-10px) scaleY(0.95);
}

.dropdown-leave-to {
	opacity: 0;
	transform: translateY(-10px) scaleY(0.95);
}

@keyframes checkmark {
	0% {
		opacity: 0;
		transform: scale(0) rotate(-45deg);
	}

	50% {
		transform: scale(1.1);
	}

	100% {
		opacity: 1;
		transform: scale(1) rotate(0deg);
	}
}
</style>
