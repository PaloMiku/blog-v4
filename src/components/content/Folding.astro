---
interface Props {
	title?: string

	/*
	 * 原组件根本没有声明 open，它靠 Vue 的 attribute fallthrough 落到根 <details> 上，
	 * 再由样式里的 `&[open]` 消费。Astro 没有 fallthrough，必须显式接收并写回属性。
	 */
	open?: boolean
}

const { title, open } = Astro.props
---

<details open={open}>
	<summary>
		<slot name="title">{title}</slot>
	</summary>
	<slot />
</details>

<style>
details {
	margin: 1em 0;
	padding: 0.5em 0.8em;
	border: 1px solid var(--c-border);
	border-radius: 0.5em;
	background-color: var(--c-bg-2);
	font-size: 0.9em;

	&[open] {
		> summary {
			margin-bottom: 0.5em;
			font-weight: bold;
			color: currentcolor;

			&::before {
				content: "收起";
			}
		}
	}

	> summary {
		margin: -0.5em -0.8em;
		padding: 0.5em 0.8em;
		color: var(--c-text-2);
		transition: all 0.2s;
		cursor: pointer;

		/* 标题 slot 内容由 MDX 渲染，需 :global() */
		> :global(p) {
			display: inline;
		}

		&::before {
			content: "展开";
			float: right;
			float: inline-end;
			opacity: 0.5;
			margin-inline-start: 0.5em;
			font-weight: normal;
			transition: color 0.2s;
		}

		&:hover {
			color: var(--c-text);
		}
	}

	/* 代码块由别的组件渲染，需 :global() */
	> :global(.z-codeblock) {
		margin: 0 -0.8em -0.5em;
	}
}
</style>
