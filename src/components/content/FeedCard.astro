---
/**
 * FeedCard 组件（Astro 版），对应 `app/components/content/FeedCard.vue`。
 * 单条友链卡片：触发区是「头像 + 博主名 + 站点昵称」，详细信息挂在 tooltip 上。
 *
 * ## 与 Nuxt 版的差异
 * 1. **UtilLink 不复用，改为就地渲染 `<a>` / `<span>`。**
 *    原版靠 Vue 的 attribute fallthrough 把 `class="feed-card gradient-card"`
 *    落到 UtilLink 的根元素上（因此 `.feed-card` 拿到本组件的 scope，样式生效）。
 *    Astro 没有 fallthrough，若把根元素交给子组件渲染，本组件 `<style>` 里的
 *    `.feed-card { … }` 会**永不匹配**（见 CLAUDE.md 坑位 1 / 2）。
 *    故这里内联 UtilLink 的两分支：`to` 为空 → `<span>`，否则外链加 `target="_blank"`
 *    **并**带 `rel="noopener"`。后半句同样出自原版：FeedCard.vue:45 显式传了
 *    `rel="noopener"`，它会把 NuxtLink 对 `_blank` 的自动值 `noopener noreferrer`
 *    整体顶掉。故**`noreferrer` 缺失是 Nuxt 基线本来的样子**（实测基线 37 个
 *    feed-card 外链一律 `rel="noopener"`）——照搬即 parity，不要「补全」成新差异。
 *    根元素留在本组件，样式与作用域均与 Vue 版一致。
 * 2. **Tooltip（vue-tippy）改为原生脚本复刻。**
 *    原版 `<Tooltip :delay="200" interactive hide-on-click="toggle">` 的
 *    `#content` 插槽在 Nuxt 产物里挂在同级的 `<span style="display:none">` 中——
 *    **SSR 阶段就是隐藏的**，本组件照搬过那个初始态，接管时因此整块缺失。
 *    现在 `<span class="feed-tip tippy-box" hidden>` 由下面的脚本接管：
 *    悬停/聚焦 200ms 后浮出、可交互（指针移进面板不收起）、离开即收。
 *    未实装的是 `hide-on-click="toggle"`（点击卡片钉住浮层）——卡片本身是外链，
 *    点击即导航，那半个特性在原版实际也几乎用不上。
 *    定位与「`.feed-list` 的 `overflow: clip` 会裁掉浮层」的取舍见样式段注释。
 * 3. **`isInspect` 调试分支（`import.meta.dev` + `?inspect`）未移植**：仅开发态可见。
 * 4. **`NuxtImg` → 裸 `<img>`**（astro:assets 属 Phase 5）：无 srcset / 尺寸优化。
 * 5. **`<Icon>` 的 `title` 属性丢失**：`Icon.astro` 未声明 `title` prop，
 *    未声明的属性会被静默丢弃（陷阱 1 同源）。故架构徽章的原生 tooltip 暂缺，
 *    只影响悬停提示，不影响可见文本。
 *
 * ## 作用域要点
 * `.avatar` / `.author` / `.site-content` 等由本组件渲染，同 scope；
 * `<Icon>`（`.no-feed` / `.domain-mark`）是子组件根元素，**不带本组件 scope**，
 * 对应的规则必须逐层写 `:global()`（陷阱 2/3）。
 */
import { Temporal } from 'temporal-polyfill'
import Icon from '../Icon.astro'
import blogConfig from '../../config/blog'
import { appConfig } from '../../lib/app-config'
import { getArchIcon, getDomain, getDomainIcon, getDomainType, getMainDomain, isExtLink } from '../../lib/shared'

/** 与 `app/types/feed.ts` 的 `FeedEntry` 同构 */
interface Props {
	author: string
	sitenick?: string
	title?: string
	desc?: string
	link: string
	feed?: string
	icon: string
	avatar: string
	archs?: string[]
	date?: string
	comment?: string
	error?: string
}

const {
	author,
	sitenick = '',
	title,
	desc,
	link,
	feed,
	icon,
	avatar,
	archs,
	date,
	comment,
	error,
} = Astro.props

const cardTitle = title ?? sitenick ?? author
const domainTip = getDomainType(getMainDomain(link, true))
const domainIcon = getDomainIcon(link)

/* —— 内联自 app/util/Link.vue（UtilLink）的两分支 —— */
const to = error ? undefined : link
const Target = to === undefined ? 'span' : 'a'
const target = to && !to.startsWith('#') && isExtLink(to) ? '_blank' : undefined
---

<span data-v-tippy role="link" data-feed-card>
	<Target
		class="feed-card gradient-card"
		href={to}
		rel={to ? 'noopener' : undefined}
		target={target}
		data-error={error}
		data-transition-enter
	>
		<div class="avatar" title={feed ? undefined : '无订阅源'}>
			<img class="round-cobblestone" src={avatar} alt={author} loading="lazy" />
			{appConfig.link.remindNoFeed && !feed && <Icon class="no-feed" name="tabler:bell-off" />}
		</div>

		<span class="author">{author}</span>
		<span class="sitenick">{sitenick}</span>
	</Target>

	<span class="feed-tip tippy-box" data-tippy-content hidden>
		<div class="site-content">
			<img class="site-icon" src={icon} alt={cardTitle} loading="lazy" />

			<div class="site-info">
				<h3 class="text-creative">
					{cardTitle}
				</h3>

				<code class="domain" title={domainTip}>
					<span>{getDomain(link)}</span>
					{domainIcon && <Icon class="domain-mark" name={domainIcon} />}
				</code>
			</div>

			{archs?.map(arch => <Icon class="arch" name={getArchIcon(arch as never)} />)}
		</div>

		<div class="desc-content">
			{date && (
				<div class="date">
					{/* SSR 阶段 mounted=false，原版走 appConfig.language 分支 */}
					{Temporal.PlainDate.from(date).toLocaleString(blogConfig.language)}
				</div>
			)}

			<p>{error ?? desc}</p>

			{comment && (
				<p>
					<Icon name="tabler:message-dots" />
					{comment}
				</p>
			)}
		</div>
	</span>
</span>

<script>
	/*
	 * 悬浮信息（Nuxt 的 `<Tooltip :delay="200" interactive>`）。
	 *
	 * vue-tippy 是 Vue runtime 依赖，Astro 侧不可用（组件文件头「Phase 4」那一条
	 * 就是这件事）。这里用 ~50 行原生脚本复刻，套路与 `partial/Dropdown.astro`、
	 * `post/Comment.astro`、`lib/prose-enhance.ts` 一致。
	 *
	 * 三个要点：
	 * 1. **面板挂到 body**（见样式里那段注释：`.feed-list` 的 `overflow: clip`）。
	 *    隐藏时**搬回卡里**，这样 Astro 的 view-transition 换掉 body 子节点时
	 *    不会把面板一起丢掉，也不用像 `.z-link-tip` 那样每次补挂。
	 * 2. **interactive**：面板移到 body 后就不再是卡的后代，指针从卡移到面板会先
	 *    触发卡的 pointerleave。故离开一律走 `hideSoon()` 的短暂宽限，
	 *    面板自身的 pointerenter 取消它——否则中间那 6px 间隙就永远跨不过去。
	 * 3. **焦点也要能出**：tippy 的默认 trigger 是 `hover focus`，
	 *    键盘用户 tab 到卡片上应当看到同样的信息。
	 */
	const SHOW_DELAY = 200
	const HIDE_GRACE = 150
	const GAP = 6
	const MARGIN = 8

	function initFeedTips() {
		for (const wrapper of document.querySelectorAll('[data-feed-card]')) {
			if (!(wrapper instanceof HTMLElement) || wrapper.dataset.tipReady)
				continue
			wrapper.dataset.tipReady = '1'

			const card = wrapper.querySelector('.feed-card')
			const panel = wrapper.querySelector('.feed-tip')
			if (!(card instanceof HTMLElement) || !(panel instanceof HTMLElement))
				continue

			let timer

			function place() {
				const cardRect = card.getBoundingClientRect()
				const w = panel.offsetWidth
				const h = panel.offsetHeight

				// 视口上沿放不下就翻到卡片下方（tippy 的 flip 等价物）
				let top = cardRect.top - h - GAP
				if (top < MARGIN)
					top = cardRect.bottom + GAP

				let left = cardRect.left + cardRect.width / 2 - w / 2
				left = Math.min(Math.max(MARGIN, left), window.innerWidth - w - MARGIN)

				panel.style.top = `${Math.round(top)}px`
				panel.style.left = `${Math.round(left)}px`
			}

			function show() {
				clearTimeout(timer)
				if (!panel.hidden)
					return
				timer = setTimeout(() => {
					document.body.appendChild(panel)
					panel.hidden = false
					place()
				}, SHOW_DELAY)
			}

			function hide() {
				clearTimeout(timer)
				if (panel.hidden)
					return
				panel.hidden = true
				panel.style.top = ''
				panel.style.left = ''
				wrapper.appendChild(panel)
			}

			function hideSoon() {
				clearTimeout(timer)
				timer = setTimeout(hide, HIDE_GRACE)
			}

			card.addEventListener('pointerenter', show)
			card.addEventListener('pointerleave', hideSoon)
			card.addEventListener('focusin', show)
			card.addEventListener('focusout', hide)
			panel.addEventListener('pointerenter', () => clearTimeout(timer))
			panel.addEventListener('pointerleave', hideSoon)
		}
	}

	if (document.readyState === 'loading')
		document.addEventListener('DOMContentLoaded', initFeedTips)
	else
		initFeedTips()
	document.addEventListener('astro:page-load', initFeedTips)
</script>

<style>
	.feed-card {
		display: flex;
		align-items: center;
		gap: 0.2em;
		width: 14em;
		margin: 1em auto;
		padding: 0.5em;
		line-height: 1.4;
		transition: transform 0.2s;
		animation: float-in 0.2s var(--delay) backwards;

		&:hover {
			transform: translateY(-2px);
		}

		&[data-error] {
			opacity: 0.5;
			cursor: not-allowed;
		}

		.avatar {
			position: relative;
			margin: 0 0.5em 0 0;

			.inspect-info {
				position: absolute;
				left: 100%;
				white-space: nowrap;
			}

			img {
				display: block;
				width: 2.5rem;
				height: 2.5rem;
				border-radius: 50%;
				box-shadow: var(--box-shadow-2);
				background-color: var(--ld-bg-card);
				object-fit: cover;
			}

			/* .no-feed 是 Icon.astro 的根元素，拿不到本组件 scope */
			:global(.no-feed) {
				position: absolute;
				inset-inline-end: -0.5em;
				bottom: 0;
			}
		}

		.author {
			overflow: hidden; /* 长词折行 */
		}

		.sitenick {
			opacity: 0.4;
			font-size: 0.8em;
		}
	}

	/* 原组件写在根级（非嵌套）的规则，作用对象同样是 Icon 的根元素 */
	.feed-card :global(.no-feed) {
		opacity: 0.6;
		font-size: 0.8em;
	}

	/*
	 * 悬浮信息：Nuxt 是 `<Tooltip :delay="200" interactive>`，这里用原生脚本复刻。
	 *
	 * ⚠️ **为什么必须挂到 body**：`.feed-list` 有 `overflow: clip`
	 * （FeedGroup.astro:197，Nuxt 原版同款），面板留在卡里会被裁掉；
	 * 挂到 body 后用 `position: fixed` + 视口坐标定位，
	 * 与 `lib/prose-enhance.ts` 的 `.z-link-tip`、`post/Comment.astro` 同一套路。
	 * 代价与它们相同：不引第三方浮层库就没有翻转与边界计算，
	 * 故下面自己补了「顶到视口上沿就翻到下方」与「左右夹进视口」两步。
	 *
	 * 面板自己就是 `.tippy-box`（沿用 main.css:150 的既有外观，同 Dropdown /
	 * Comment / prose 的做法），`padding: 0` 是因为内边距由 `.site-content`
	 * 与 `.desc-content` 各自提供——原版也是这么把 tippy 默认的
	 * `padding: 0.3em 0.6em` 归零的。
	 *
	 * 原版那两条 `:global([data-feed-card]) ~ [data-tippy-root] > .tippy-box…)`
	 * 随这次实装一并删掉：tippy 的宿主元素不再存在，规则永远匹配不到。
	 * `check-scope-anchors` 的 UNREVIEWED 名单同步删这两条。
	 */
	.feed-tip {
		position: fixed;
		z-index: var(--z-index-popover);
		max-width: min(24em, calc(100vw - 1rem));
		padding: 0;
		overflow: clip;
		text-align: start;
	}

	.site-content {
		display: flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.5em 1em;

		.site-icon {
			width: 1.5rem;
			height: 1.5rem;
			border-radius: 4px;
			object-fit: contain;
		}

		.site-info {
			flex: 1;
			margin-inline-end: 0.5em;

			.domain {
				font-size: 0.9em;
			}

			/* .domain-mark 是 Icon.astro 的根元素 */
			:global(.domain-mark) {
				font-size: 0.8em;
				vertical-align: super;
			}
		}
	}

	.desc-content {
		position: relative;
		padding: 0.5em 1em;
		background-color: var(--c-bg-1);

		p + p {
			margin-top: 0.5em;
		}

		.date {
			position: absolute;
			opacity: 0.1;
			inset-inline-end: -0.1em;
			bottom: -0.3em;
			font-size: 3em;
			font-weight: bold;
			white-space: nowrap;
			pointer-events: none;
		}
	}
</style>
