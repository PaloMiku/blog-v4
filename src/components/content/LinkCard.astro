---
// ImgService 与 Nuxt 侧同源，临时跨项目引用，正式实现见 Phase 5（astro:assets）
import type { ImgService } from '../../lib/img'
import { getDomain, isExtLink, joinWith } from '../../lib/shared'

interface Props {
	link: string
	title: string
	description?: string
	icon?: string
	/** 图片镜像服务，Phase 5 接入 astro:assets 后才会被消费 */
	mirror?: ImgService
	/**
	 * 原来这里没有 class prop，靠 Vue 的 attribute fallthrough 接收 MDX 传入的 className。
	 * Astro 没有 fallthrough（已实测：传入的 class 会被丢弃），必须显式接收再合并。
	 */
	class?: string
}

const { link, title, description, icon, class: className } = Astro.props

// 照搬 Nuxt 侧 UtilLink 的分支：锚点链接不加 target
const target = !link.startsWith('#') && isExtLink(link) ? '_blank' : undefined
/*
 * rel 是 UtilLink 分支的**另一半**，不能只照搬 target：
 * Nuxt 侧走的是 `NuxtLink`（app/components/util/Link.vue:8），它对 `target="_blank"`
 * 自动补 `rel="noopener noreferrer"`；本组件就地渲染裸 `<a>`，没人替我们补。
 * 实测漏掉时产物里 20 个外链 LinkCard 一个 rel 都没有。同源链接 Nuxt 也不加，不加。
 */
const relValue = target === '_blank' ? 'noopener noreferrer' : undefined
---

<a
	href={link}
	class:list={['link-card card', className]}
	data-transition-key={link}
	title={joinWith([title, description, link])}
	target={target}
	rel={relValue}
>
	<div class="link-card-info">
		<div class="link-card-title">
			{title}
		</div>
		<div class="link-card-description">
			{description ?? getDomain(link)}
		</div>
	</div>
	<slot name="icon">
		{icon && <img class="link-card-icon" src={icon} alt="" />}
	</slot>
</a>

<style>
.link-card {
	display: flex;
	align-items: center;
	gap: 0.5rem;
	padding: 0.5em 0.8em;
	font-size: 0.9em;
	line-height: 1.4;

	/*
	 * article 由页面（MDX）渲染，带的是父级 scope class。
	 * Vue 把 scope 挂在 `&` 上（`article .link-card[data-v-x]`），
	 * Astro 默认会连 article 一起加上，那就永远匹配不上了，必须 :global()。
	 */
	:global(article) & {
		width: 20rem;
		max-width: 90%;
		margin: 2rem auto;
	}

	/* 溢出显示省略号 */
	.link-card-info {
		flex-grow: 1;
		overflow: hidden;
	}

	.link-card-title {
		display: -webkit-box;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
	}

	/* 内部需要是块元素 */
	.link-card-description {
		overflow: hidden;
		opacity: 0.5;
		margin-top: 0.2em;
		font-size: 0.9em;
		white-space: nowrap;
		text-overflow: ellipsis;
	}

	.link-card-icon {
		flex-shrink: 0;
		height: 3rem;
		max-width: 5rem;
		border-radius: 0.5rem;
		object-fit: cover;
	}
}
</style>
