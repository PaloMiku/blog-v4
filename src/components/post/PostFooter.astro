---
/**
 * PostFooter 组件（Astro 版）—— 文章末尾的作者卡片与参考链接。
 *
 * 对应 `app/components/post/PostFooter.vue`。原版是纯计算（computed 派生展示字段），
 * 无交互，直接改为构建期计算。
 *
 * 与 Nuxt 版的差异：参考链接原用 MDC 映射的 `ProseA`（带域名图标），
 * 此处内联为 `<a>` + `getDomainIcon`，产出相同结构。
 */
import Icon from '../Icon.astro'
import blogConfig from '../../config/blog'
import { getDomainIcon, isExtLink } from '../../lib/shared'
import { toZdtLocaleString } from '../../lib/shared/time'

/**
 * `month: 'long'` + 不补零 ⇒ 与线上逐字一致的「2024年3月7日」形态。
 *
 * ⚠️ 这里**不能**用 `dateTimeFormat.full`：那个具名格式是 `month/day: '2-digit'`
 * 且带时分秒，产出的是完全不同的形状。`toZdtLocaleString` 的第二个参数是
 * `dateTimeFormatOptions = keyof typeof dateTimeFormat | Intl.DateTimeFormatOptions`
 * （见 time.ts:110），所以具名格式与 options 对象两种写法都收，这里要的是后者。
 */
const postFooterDateFormat = { year: 'numeric', month: 'long', day: 'numeric' } as const

/**
 * 格式化 frontmatter 的 `date` / `updated`。
 *
 * ⚠️ 此前这里是自写的一份 `formatDate`：`new Date(value).toLocaleDateString('zh-CN', …)`，
 * 既没走 `toZonedTemporal`，也没用 `blogConfig.language` / `blogConfig.timeZone`——
 * 违反 `util/Date.astro:97-127` 那条「两个都不能留」的硬约定。
 *
 * 但要说清楚：**这不是在修一个正在发生的缺陷**。当前输出是对的，且产物逐字不变
 * （已核验：`src/content` 下全部 mdx 里的 46 个真实 date/updated 原串，
 *  旧实现与新实现输出 46/46 完全相同）。它成立靠的是两件碰巧同时成立的事：
 *   1. frontmatter 里是**裸墙钟**（`2024-03-07 17:00:00`），而构建机时区恰好
 *      是 `blogConfig.timeZone`（Asia/Shanghai），于是 `new Date(str)` 的
 *      「按构建机本地时区解析」与 `toZonedTemporal` 的「按 Asia/Shanghai 解析」
 *      落在同一个瞬间上；
 *   2. 硬编码的 `'zh-CN'` 恰好等于 `blogConfig.language`。
 * 任何一条不成立（CI 的 `TZ=UTC` runner 就是现成的例子），
 * 产物就会随构建环境变——`util/Date.astro` 头注记的就是 2026-10-03 那次
 * 63/63 篇全是英文日期的线上事故。同族教训见 CLAUDE.md 坑位 26。
 *
 * 所以这次是**消除约定违反 + 去掉时区依赖**，不是修回归。
 */
function formatDate(value?: string): string {
	if (!value)
		return ''
	try {
		// 守卫保留：`toZonedTemporal` 三级回退全抛时（格式非法）会把异常抛到这里，
		// 与旧实现的 `Number.isNaN(d.getTime())` 分支同为「给不出结果就返回空串」。
		return toZdtLocaleString(value, postFooterDateFormat)
	}
	catch {
		return ''
	}
}

interface Reference {
	title?: string
	link?: string
}

interface Props {
	title?: string
	path?: string
	date?: string
	updated?: string
	references?: Reference[]
	hideInfo?: boolean
}

const { title = '', path = '', date, updated, references } = Astro.props

const fullUrl = path
	? (() => {
		try {
			return new URL(path, blogConfig.url).href
		}
		catch {
			return ''
		}
	})()
	: ''

const formattedDate = formatDate(date)
const formattedUpdatedDate = formatDate(updated)
---

<div class="post-footer">
	<section class="author-card">
		<div class="copyright-badge">
			<Icon name="tabler:copyright" />
		</div>

		<div class="card-left">
			<div class="card-header">
				<div class="author-info">
					<h3 class="title">{title}</h3>
					{path && (
						<div class="url-wrapper">
							<p class="url">{fullUrl}</p>
						</div>
					)}
				</div>
			</div>

			<div class="card-meta">
				<div class="meta-column">
					<div class="meta-item">
						<span class="label">文章作者</span>
						<span class="value">{blogConfig.author.name}</span>
					</div>
					{date && (
						<div class="meta-item">
							<span class="label">发布时间</span>
							<span class="value">{formattedDate}</span>
						</div>
					)}
					{updated && updated !== date && (
						<div class="meta-item">
							<span class="label">更新时间</span>
							<span class="value">{formattedUpdatedDate}</span>
						</div>
					)}
					<div class="meta-item">
						<span class="label">版权信息</span>
						<a href={blogConfig.copyright.url} class="value copyright-link">
							{blogConfig.copyright.name}
						</a>
					</div>
				</div>
			</div>
		</div>

		<div class="card-signature-text">
			PaloMiku
		</div>

		{references && (
			<section class="reference">
				<div id="references" class="title text-creative">
					参考链接
				</div>
				<div class="content">
					<ul>
						{references.map((ref, i) => (
							<li key={i}>
								<a href={ref.link || ''} class="prose-a">
									{isExtLink(ref.link) && <Icon name={getDomainIcon(ref.link!)} class="prose-a-icon" />}
									{ref.title ?? ref.link}
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		)}
	</section>
</div>

<style scoped>
.post-footer {
	margin: 2rem 0.5rem;
	border: 1px solid var(--c-border);
	border-radius: 1rem;
	background-color: var(--c-bg-2);
}

section {
	padding: 1.2rem;

	& + section {
		border-top: 1px solid var(--c-border);
	}
}

.title {
	font-weight: bold;
	color: var(--c-text);
}

.content {
	margin-top: 0.5em;
	font-size: 0.9rem;

	li {
		margin: 0.5em 0;
	}
}

.author-card {
	display: flex;
	flex-direction: column;
	gap: 1rem;
	position: relative;
	padding: 1.5rem;
}

.copyright-badge {
	position: absolute;
	opacity: 0.5;
	top: 1.5rem;
	right: 1.5rem;
	font-size: 2rem;
	color: var(--c-border);
}

.card-left {
	display: flex;
	flex-direction: column;
	gap: 1rem;
}

.card-header {
	display: flex;
	align-items: flex-start;
}

.author-info .title {
	margin: 0 0 0.5rem;
	font-size: 1.1rem;
	line-height: 1.4;
}

.url-wrapper {
	display: flex;
	align-items: center;
	gap: -0.05rem;
}

.url {
	flex: 1;
	min-width: 0;
	margin: 0;
	font-size: 0.85rem;
	word-break: break-all;
	color: var(--c-text-2);
}

.card-meta {
	.meta-column {
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
	}

	.meta-item {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.label {
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--c-text-2);
	}

	.value {
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--c-text-1);
	}

	.copyright-link {
		text-decoration: none;
		color: var(--c-primary);
		transition: opacity 0.2s;
	}

	.copyright-link:hover {
		opacity: 0.8;
	}
}

.card-signature-text {
	position: absolute;
	opacity: 0.95;
	right: 1.5rem;
	bottom: 1.5rem;
	padding: 0.25rem 0.4rem;
	border-radius: 0.35rem;
	background-color: transparent;
	font-family: Ephesis, var(--font-creative), sans-serif;
	font-size: 2rem;
	font-weight: 700;
	text-shadow: 0 0 4px rgb(255 255 255 / 25%);
	color: var(--c-text);
	z-index: 2;
}

@media (max-width: 768px) {
	.card-signature-text {
		align-self: flex-end;
		position: relative;
		right: auto;
		bottom: auto;
		margin-top: 0.7rem;
		background-color: transparent;
		text-align: right;
	}
}

@media (prefers-color-scheme: dark) {
	.card-signature-text {
		background-color: transparent;
		text-shadow: 0 0 3px rgb(0 0 0 / 35%);
	}
}

.dark .card-signature-text {
	background-color: transparent;
	text-shadow: 0 0 3px rgb(0 0 0 / 35%);
}

.reference .content ul {
	margin: 0;
	padding: 0;
	list-style: none;
}
.reference .content li { margin: 0.6rem 0; }
</style>