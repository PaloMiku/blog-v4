---
/**
 * PostFooter 组件（Astro 版）—— 文章末尾的作者卡片与参考链接。
 *
 * 对应 `app/components/post/PostFooter.vue`。原版是纯计算（computed 派生展示字段），
 * 无交互，直接改为构建期计算。
 *
 * 与 Nuxt 版的差异：参考链接原用 MDC 映射的 `ProseA`（带域名图标），
 * 此处内联为 `<a>` + `getDomainIcon`，产出相同结构。
 */
import Icon from '../Icon.astro'
import blogConfig from '../../config/blog'
import { getDomainIcon, isExtLink } from '../../lib/shared'

interface Reference {
	title?: string
	link?: string
}

interface Props {
	title?: string
	path?: string
	date?: string
	updated?: string
	references?: Reference[]
	hideInfo?: boolean
}

const { title = '', path = '', date, updated, references } = Astro.props

const fullUrl = path
	? (() => {
		try {
			return new URL(path, blogConfig.url).href
		}
		catch {
			return ''
		}
	})()
	: ''

function formatDate(value?: string): string {
	if (!value)
		return ''
	try {
		const d = new Date(value)
		if (Number.isNaN(d.getTime()))
			return ''
		return d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })
	}
	catch {
		return ''
	}
}

const formattedDate = formatDate(date)
const formattedUpdatedDate = formatDate(updated)
---

<div class="post-footer">
	<section class="author-card">
		<div class="copyright-badge">
			<Icon name="tabler:copyright" />
		</div>

		<div class="card-left">
			<div class="card-header">
				<div class="author-info">
					<h3 class="title">{title}</h3>
					{path && (
						<div class="url-wrapper">
							<p class="url">{fullUrl}</p>
						</div>
					)}
				</div>
			</div>

			<div class="card-meta">
				<div class="meta-column">
					<div class="meta-item">
						<span class="label">文章作者</span>
						<span class="value">{blogConfig.author.name}</span>
					</div>
					{date && (
						<div class="meta-item">
							<span class="label">发布时间</span>
							<span class="value">{formattedDate}</span>
						</div>
					)}
					{updated && updated !== date && (
						<div class="meta-item">
							<span class="label">更新时间</span>
							<span class="value">{formattedUpdatedDate}</span>
						</div>
					)}
					<div class="meta-item">
						<span class="label">版权信息</span>
						<a href={blogConfig.copyright.url} class="value copyright-link">
							{blogConfig.copyright.name}
						</a>
					</div>
				</div>
			</div>
		</div>

		<div class="card-signature-text">
			PaloMiku
		</div>

		{references && (
			<section class="reference">
				<div id="references" class="title text-creative">
					参考链接
				</div>
				<div class="content">
					<ul>
						{references.map((ref, i) => (
							<li key={i}>
								<a href={ref.link || ''} class="prose-a">
									{isExtLink(ref.link) && <Icon name={getDomainIcon(ref.link!)} class="prose-a-icon" />}
									{ref.title ?? ref.link}
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		)}
	</section>
</div>

<style scoped>
.post-footer {
	margin: 2rem 0.5rem;
	border: 1px solid var(--c-border);
	border-radius: 1rem;
	background-color: var(--c-bg-2);
}

section {
	padding: 1.2rem;

	& + section {
		border-top: 1px solid var(--c-border);
	}
}

.title {
	font-weight: bold;
	color: var(--c-text);
}

.content {
	margin-top: 0.5em;
	font-size: 0.9rem;

	li {
		margin: 0.5em 0;
	}
}

.author-card {
	display: flex;
	flex-direction: column;
	gap: 1rem;
	position: relative;
	padding: 1.5rem;
}

.copyright-badge {
	position: absolute;
	opacity: 0.5;
	top: 1.5rem;
	right: 1.5rem;
	font-size: 2rem;
	color: var(--c-border);
}

.card-left {
	display: flex;
	flex-direction: column;
	gap: 1rem;
}

.card-header {
	display: flex;
	align-items: flex-start;
}

.author-info .title {
	margin: 0 0 0.5rem;
	font-size: 1.1rem;
	line-height: 1.4;
}

.url-wrapper {
	display: flex;
	align-items: center;
	gap: -0.05rem;
}

.url {
	flex: 1;
	min-width: 0;
	margin: 0;
	font-size: 0.85rem;
	word-break: break-all;
	color: var(--c-text-2);
}

.card-meta {
	.meta-column {
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
	}

	.meta-item {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.label {
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--c-text-2);
	}

	.value {
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--c-text-1);
	}

	.copyright-link {
		text-decoration: none;
		color: var(--c-primary);
		transition: opacity 0.2s;
	}

	.copyright-link:hover {
		opacity: 0.8;
	}
}

.card-signature-text {
	position: absolute;
	opacity: 0.95;
	right: 1.5rem;
	bottom: 1.5rem;
	padding: 0.25rem 0.4rem;
	border-radius: 0.35rem;
	background-color: transparent;
	font-family: Ephesis, var(--font-creative), sans-serif;
	font-size: 2rem;
	font-weight: 700;
	text-shadow: 0 0 4px rgb(255 255 255 / 25%);
	color: var(--c-text);
	z-index: 2;
}

@media (max-width: 768px) {
	.card-signature-text {
		align-self: flex-end;
		position: relative;
		right: auto;
		bottom: auto;
		margin-top: 0.7rem;
		background-color: transparent;
		text-align: right;
	}
}

@media (prefers-color-scheme: dark) {
	.card-signature-text {
		background-color: transparent;
		text-shadow: 0 0 3px rgb(0 0 0 / 35%);
	}
}

.dark .card-signature-text {
	background-color: transparent;
	text-shadow: 0 0 3px rgb(0 0 0 / 35%);
}

.reference .content ul {
	margin: 0;
	padding: 0;
	list-style: none;
}
.reference .content li { margin: 0.6rem 0; }
</style>